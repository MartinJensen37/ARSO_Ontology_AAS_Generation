    sh:property [ a sh:PropertyShape ;
            sh:path <https://admin-shell.io/aas/3/1/SubmodelElementCollection/value> ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:class ns1:GuidelineSpecificPropertiesSML ] ],
        ns1:AssetSpecificPropertiesSMC-https___admin-shell.io_aas_3_1_SubmodelElementCollection_value ;
    ns1:semanticId "0173-1#02-ABI218#003/0173-1#01-AGZ672#004" .

ns1:BuildingBlockSMC a rdfs:Class,
        owl:Class,
        sh:NodeShape ;
    rdfs:comment "SMC {name} — a skill primitive that only runs as a step of composite skills. Applied to every direct child of BuildingBlocks. Contains SemanticId and Implementation (FBType: the block type a step of it is an instance of; both mandatory) and, as a skill of Kind Primitive does, Kind, Parameters (value: the default), Contract and Occupies; Results declares what a step of it gives back." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://admin-shell.io/aas/3/1/SubmodelElementCollection/value> ;
            owl:someValuesFrom ns1:SkillSemanticIdProperty ],
        [ a owl:Restriction ;
            owl:onProperty <https://admin-shell.io/aas/3/1/SubmodelElementCollection/value> ;
            owl:someValuesFrom ns1:SkillImplementationSMC ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ns1:SkillKindProperty ;
            owl:onProperty <https://admin-shell.io/aas/3/1/SubmodelElementCollection/value> ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ns1:SkillParametersSMC ;
            owl:onProperty <https://admin-shell.io/aas/3/1/SubmodelElementCollection/value> ],
        [ a owl:Restriction ;

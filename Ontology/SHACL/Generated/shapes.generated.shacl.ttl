    rdfs:comment "The value of the property instance."@en ;
    rdfs:domain <https://admin-shell.io/aas/3/1/MultiLanguageProperty> ;
    rdfs:range <https://admin-shell.io/aas/3/1/LangStringTextType> .

<https://admin-shell.io/aas/3/1/MultiLanguageProperty/valueId> a owl:ObjectProperty ;

ns1:TechnicalDataSubmodel a rdfs:Class,
        owl:Class,
        sh:NodeShape ;
    rdfs:label "Technical Data Submodel" ;
    rdfs:comment "IDTA 02003 — Technical Data for product-related information." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass ns1:TechnicalGeneralInformationSMC ;
            owl:onProperty <https://admin-shell.io/aas/3/1/Submodel/submodelElements> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],

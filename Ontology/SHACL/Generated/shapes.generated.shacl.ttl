    rdfs:domain <https://admin-shell.io/aas/3/1/Entity> ;
    rdfs:range xsd:string .

<https://admin-shell.io/aas/3/1/Property/valueType> a owl:ObjectProperty ;
    rdfs:label "has value type"^^xsd:string ;
    rdfs:comment "Data type of the value"@en ;
    rdfs:domain <https://admin-shell.io/aas/3/1/Property> ;
    rdfs:range <https://admin-shell.io/aas/3/1/DataTypeDefXsd> .

<https://admin-shell.io/aas/3/1/SubmodelElementList/orderRelevant> a owl:DatatypeProperty ;
    rdfs:label "has order relevant"^^xsd:string ;
    rdfs:comment "Defines whether order in list is relevant. If 'orderRelevant' = False then the list is representing a set or a bag."@en ;
    rdfs:domain <https://admin-shell.io/aas/3/1/SubmodelElementList> ;
    rdfs:range xsd:boolean .

<https://admin-shell.io/aas/3/1/SubmodelElementList/semanticIdListElement> a owl:ObjectProperty ;

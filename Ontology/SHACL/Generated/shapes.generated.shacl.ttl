    rdfs:domain <https://admin-shell.io/aas/3/1/MultiLanguageProperty> ;
    rdfs:range <https://admin-shell.io/aas/3/1/Reference> .

<https://admin-shell.io/aas/3/1/Operation/inoutputVariables> a owl:ObjectProperty ;
    rdfs:label "has inoutput variables"^^xsd:string ;
    rdfs:comment "Parameter that is input and output of the operation."@en ;
    rdfs:domain <https://admin-shell.io/aas/3/1/Operation> ;
    rdfs:range <https://admin-shell.io/aas/3/1/OperationVariable> .

<https://admin-shell.io/aas/3/1/Operation/inputVariables> a owl:ObjectProperty ;
    rdfs:label "has input variables"^^xsd:string ;
    rdfs:comment "Input parameter of the operation."@en ;
    rdfs:domain <https://admin-shell.io/aas/3/1/Operation> ;
    rdfs:range <https://admin-shell.io/aas/3/1/OperationVariable> .

<https://admin-shell.io/aas/3/1/Operation/outputVariables> a owl:ObjectProperty ;
    rdfs:label "has output variables"^^xsd:string ;
    rdfs:comment "Output parameter of the operation."@en ;
    rdfs:domain <https://admin-shell.io/aas/3/1/Operation> ;
    rdfs:range <https://admin-shell.io/aas/3/1/OperationVariable> .

<https://admin-shell.io/aas/3/1/Range/max> a owl:DatatypeProperty ;
    rdfs:label "has max"^^xsd:string ;
    rdfs:comment "The maximum value of the range."@en ;
    rdfs:domain <https://admin-shell.io/aas/3/1/Range> ;
    rdfs:range xsd:string .

<https://admin-shell.io/aas/3/1/Range/min> a owl:DatatypeProperty ;
    rdfs:label "has min"^^xsd:string ;
    rdfs:comment "The minimum value of the range."@en ;
    rdfs:domain <https://admin-shell.io/aas/3/1/Range> ;
    rdfs:range xsd:string .

<https://admin-shell.io/aas/3/1/Range/valueType> a owl:ObjectProperty ;
    rdfs:label "has value type"^^xsd:string ;
    rdfs:comment "Data type of the min und max"@en ;
    rdfs:domain <https://admin-shell.io/aas/3/1/Range> ;
    rdfs:range <https://admin-shell.io/aas/3/1/DataTypeDefXsd> .

<https://admin-shell.io/aas/3/1/ReferenceElement/value> a owl:ObjectProperty ;
    rdfs:label "has value"^^xsd:string ;
    rdfs:comment "Global reference to an external object or entity or a logical reference to another element within the same or another AAS (i.e. a model reference to a Referable)."@en ;
    rdfs:domain <https://admin-shell.io/aas/3/1/ReferenceElement> ;
    rdfs:range <https://admin-shell.io/aas/3/1/Reference> .

<https://admin-shell.io/aas/3/1/AnnotatedRelationshipElement/annotations> a owl:ObjectProperty ;
    rdfs:label "has annotations"^^xsd:string ;
    rdfs:comment "A data element that represents an annotation that holds for the relationship between the two elements"@en ;
    rdfs:domain <https://admin-shell.io/aas/3/1/AnnotatedRelationshipElement> ;
    rdfs:range <https://admin-shell.io/aas/3/1/DataElement> .

<https://admin-shell.io/aas/3/1/RelationshipElement/first> a owl:ObjectProperty ;
    rdfs:label "has first"^^xsd:string ;
    rdfs:comment "Reference to the first element in the relationship taking the role of the subject."@en ;
    rdfs:domain <https://admin-shell.io/aas/3/1/RelationshipElement> ;
    rdfs:range <https://admin-shell.io/aas/3/1/Reference> .

<https://admin-shell.io/aas/3/1/RelationshipElement/second> a owl:ObjectProperty ;
    rdfs:label "has second"^^xsd:string ;
    rdfs:comment "Reference to the second element in the relationship taking the role of the object."@en ;
    rdfs:domain <https://admin-shell.io/aas/3/1/RelationshipElement> ;
    rdfs:range <https://admin-shell.io/aas/3/1/Reference> .

ns1:hasAIDSubmodel a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:range ns1:AIDSubmodel ;
    rdfs:subPropertyOf ns1:hasSubmodel .

ns1:hasAIMCSubmodel a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:range ns1:AIMCSubmodel ;
    rdfs:subPropertyOf ns1:hasSubmodel .

ns1:hasCapabilitiesSubmodel a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:range ns1:CapabilitiesSubmodel ;
    rdfs:subPropertyOf ns1:hasSubmodel .

ns1:hasControlConfigurationSubmodel a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:range ns1:ControlConfigurationSubmodel ;
    rdfs:subPropertyOf ns1:hasSubmodel .

ns1:hasDigitalNameplateSubmodel a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:range ns1:DigitalNameplateSubmodel ;
    rdfs:subPropertyOf ns1:hasSubmodel .

ns1:hasHierarchicalStructuresSubmodel a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:range ns1:HierarchicalStructuresSubmodel ;
    rdfs:subPropertyOf ns1:hasSubmodel .

ns1:hasOperationalDataSubmodel a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:range ns1:OperationalDataSubmodel ;
    rdfs:subPropertyOf ns1:hasSubmodel .

ns1:hasParametersSubmodel a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:range ns1:ParametersSubmodel ;
    rdfs:subPropertyOf ns1:hasSubmodel .

ns1:hasSkillsSubmodel a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:range ns1:SkillsSubmodel ;
    rdfs:subPropertyOf ns1:hasSubmodel .

ns1:hasTechnicalDataSubmodel a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:range ns1:TechnicalDataSubmodel ;
    rdfs:subPropertyOf ns1:hasSubmodel .

ns1:occupies a owl:ObjectProperty ;
    rdfs:comment "Resolved Occupies entry: the HierarchicalStructures node (equipment) the skill locks while it runs." ;
    rdfs:domain ns1:SkillSMC ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( ns1:EntryNodeEntity ns1:NodeEntity ) ] .

ns1:realizedBySkill a owl:ObjectProperty ;
    rdfs:comment "Resolved CapabilityRealizedBy: the skill that realizes an offered capability (same AAS)." ;
    rdfs:domain ns1:CapabilityContainerSMC ;
    rdfs:range ns1:SkillSMC .

ns1:realizesProperty a owl:ObjectProperty ;
    rdfs:comment "Resolved RealizesProperty: the capability property a skill parameter realizes." ;
    rdfs:domain ns1:SkillParameterProperty ;
    rdfs:range ns1:PropertyContainerSMC .

ns1:representsResource a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:comment "The CSS Resource this AAS represents." ;
    rdfs:domain ns1:ResourceAAS ;
    rdfs:range <http://www.w3id.org/hsu-aut/css#Resource> ;
    owl:inverseOf ns1:hasAAS .

ns1:usesSkill a owl:ObjectProperty ;
    rdfs:comment "Resolved Uses entry: a composite skill uses this skill or building block (same AAS or an AAS that is a part of it)." ;
    rdfs:domain ns1:SkillSMC ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( ns1:SkillSMC ns1:BuildingBlockSMC ) ] ;
    ns1:resolvedFrom ns1:SkillUsesSML .

<http://www.w3id.org/hsu-aut/css#Product> a owl:Class ;
    rdfs:comment """Physical object being used as an input or created as an output of a production process.\r
\r
Notes:\r
- The term Product may be used for objects in various states of manufacturing and may be seen as a generic term for raw materials, work in process and finished goods. Consumable supplies such as fuel, lubricants or cleaning agents may also be regarded as products. Furthermore, both purchased parts as well as parts manufactured in-house may be regarded as products.\r
- Besides the actual product, there can be additional artifacts related to that product that are created and used in different life cycle phases to specify the product.\r
▪ 3D/CAD models\r
▪ specifications\r
▪ BOM\r
- A Service Requester may use these additional artifacts to formulate requirements against products.""" ;
    owl:disjointWith <http://www.w3id.org/hsu-aut/css#Service>,
        <http://www.w3id.org/hsu-aut/css#ServiceOffer>,
        <http://www.w3id.org/hsu-aut/css#ServiceProvider>,
        <http://www.w3id.org/hsu-aut/css#ServiceRequester>,
        <http://www.w3id.org/hsu-aut/css#Skill>,
        <http://www.w3id.org/hsu-aut/css#SkillInterface>,
        <http://www.w3id.org/hsu-aut/css#SkillParameter> .

<https://admin-shell.io/aas/3/1/DataElement> a owl:Class ;
    rdfs:label "Data Element"^^xsd:string ;
    rdfs:comment "A data element is a submodel element that is not further composed out of other submodel elements."@en ;
    rdfs:subClassOf <https://admin-shell.io/aas/3/1/SubmodelElement> .

<https://admin-shell.io/aas/3/1/Entity/specificAssetIds> a owl:ObjectProperty ;
    rdfs:label "has specific asset IDs"^^xsd:string ;
    rdfs:comment "Reference to a specific asset ID representing a supplementary identifier of the asset represented by the Asset Administration Shell."@en ;
    rdfs:domain <https://admin-shell.io/aas/3/1/Entity> ;
    rdfs:range <https://admin-shell.io/aas/3/1/SpecificAssetId> .

<https://admin-shell.io/aas/3/1/Property/valueId> a owl:ObjectProperty ;
    rdfs:label "has value ID"^^xsd:string ;
    rdfs:comment "Reference to the global unique ID of a coded value."@en ;
    rdfs:domain <https://admin-shell.io/aas/3/1/Property> ;
    rdfs:range <https://admin-shell.io/aas/3/1/Reference> .

ns1:FormsSMC a owl:Class ;
    rdfs:comment "SMC Forms — protocol binding for an interaction affordance. Must contain href." ;
    rdfs:subClassOf <https://admin-shell.io/aas/3/1/SubmodelElementCollection> ;
    ns1:idShort "Forms" ;
    ns1:parentClass ns1:ActionDefinitionSMC,
        ns1:EventDefinitionSMC,
        ns1:PropertyDefinitionSMC ;
    ns1:semanticId "https://www.w3.org/2019/wot/td#hasForm" .

<https://admin-shell.io/aas/3/1/Entity/entityType> a owl:ObjectProperty ;
    rdfs:label "has entity type"^^xsd:string ;
    rdfs:comment "Describes whether the entity is a co-managed entity or a self-managed entity."@en ;
    rdfs:domain <https://admin-shell.io/aas/3/1/Entity> ;
    rdfs:range <https://admin-shell.io/aas/3/1/EntityType> .

<https://admin-shell.io/aas/3/1/Entity/globalAssetId> a owl:DatatypeProperty ;
    rdfs:label "has global asset ID"^^xsd:string ;

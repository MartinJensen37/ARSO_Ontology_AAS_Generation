    rdfs:subClassOf <https://admin-shell.io/aas/3/1/SubmodelElementCollection> ;
    ns1:semanticId "0173-1#02-ABL358#002/0173-1#01-AHX773#002" .

ns1:TechnicalSpecificDescriptionSMC a owl:Class ;
    rdfs:comment "SMC SpecificDescription — one specific description entry." ;
    rdfs:subClassOf <https://admin-shell.io/aas/3/1/SubmodelElementCollection> ;
    ns1:semanticId "0173-1#02-ABM221#001/0173-1#01-AHY912#001" .


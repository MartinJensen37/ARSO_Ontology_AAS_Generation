ns1:ResourceAAS a rdfs:Class,
        owl:Class,
        sh:NodeShape ;
    rdfs:label "Resource AAS" ;
    rdfs:comment "Asset Administration Shell of a resource (line, module, component). v0.5: the restrictions below apply to this class, not to every aas:AssetAdministrationShell, so ARSO can be loaded together with the product (APSO) and process (AProSO) blueprints without every shell having to represent a css:Resource. The JSON-to-RDF projection types a shell as ResourceAAS when it represents a resource, e.g. when its derivedFrom is the lab's resource template (https://smartproductionlab.aau.dk/aas/templates/resource)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass ns1:HierarchicalStructuresSubmodel ;
            owl:onProperty ns1:hasHierarchicalStructuresSubmodel ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ns1:AIDSubmodel ;
            owl:onProperty ns1:hasAIDSubmodel ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ns1:SkillsSubmodel ;
            owl:onProperty ns1:hasSkillsSubmodel ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ns1:CapabilitiesSubmodel ;
            owl:onProperty ns1:hasCapabilitiesSubmodel ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ns1:OperationalDataSubmodel ;
            owl:onProperty ns1:hasOperationalDataSubmodel ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ns1:ParametersSubmodel ;
            owl:onProperty ns1:hasParametersSubmodel ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ns1:TechnicalDataSubmodel ;
            owl:onProperty ns1:hasTechnicalDataSubmodel ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ns1:ControlConfigurationSubmodel ;
            owl:onProperty ns1:hasControlConfigurationSubmodel ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ns1:AIMCSubmodel ;
            owl:onProperty ns1:hasAIMCSubmodel ],
        [ a owl:Restriction ;
            owl:onClass <http://www.w3id.org/hsu-aut/css#Resource> ;
            owl:onProperty ns1:representsResource ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass ns1:DigitalNameplateSubmodel ;
            owl:onProperty ns1:hasDigitalNameplateSubmodel ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        <https://admin-shell.io/aas/3/1/AssetAdministrationShell> ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type rdfs:comment rdfs:label <https://admin-shell.io/aas/3/1/AssetAdministrationShell/assetInformation> <https://admin-shell.io/aas/3/1/AssetAdministrationShell/derivedFrom> <https://admin-shell.io/aas/3/1/AssetAdministrationShell/submodels> <https://admin-shell.io/aas/3/1/HasDataSpecification/embeddedDataSpecifications> <https://admin-shell.io/aas/3/1/HasExtensions/extensions> <https://admin-shell.io/aas/3/1/Identifiable/administration> <https://admin-shell.io/aas/3/1/Identifiable/id> <https://admin-shell.io/aas/3/1/Referable/category> <https://admin-shell.io/aas/3/1/Referable/description> <https://admin-shell.io/aas/3/1/Referable/displayName> <https://admin-shell.io/aas/3/1/Referable/idShort> ns1:hasSubmodel ) ;
    sh:property ns1:ResourceAAS-hasAIDSubmodel,
        ns1:ResourceAAS-hasAIMCSubmodel,
        ns1:ResourceAAS-hasCapabilitiesSubmodel,
        ns1:ResourceAAS-hasControlConfigurationSubmodel,
        ns1:ResourceAAS-hasDigitalNameplateSubmodel,
        ns1:ResourceAAS-hasHierarchicalStructuresSubmodel,
        ns1:ResourceAAS-hasOperationalDataSubmodel,

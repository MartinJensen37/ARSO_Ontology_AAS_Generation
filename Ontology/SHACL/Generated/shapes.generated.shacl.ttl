ns1:OPCUAAuthenticationSecuritySchemeSMC a owl:Class ;
    rdfs:comment "SMC opcua_authentication_sc — OPC UA user authentication scheme. semanticId: http://opcfoundation.org/UA/WoT-Binding/OPCUASecurityAuthenticationScheme" ;
    rdfs:subClassOf ns1:SecuritySchemeSMC ;
    ns1:semanticId "http://opcfoundation.org/UA/WoT-Binding/OPCUASecurityAuthenticationScheme" .

ns1:OPCUAChannelSecuritySchemeSMC a owl:Class ;
    rdfs:comment "SMC opcua_channel_sc — OPC UA channel security scheme. semanticId: http://opcfoundation.org/UA/WoT-Binding/OPCUASecurityChannelScheme" ;
    rdfs:subClassOf ns1:SecuritySchemeSMC ;
    ns1:semanticId "http://opcfoundation.org/UA/WoT-Binding/OPCUASecurityChannelScheme" .

ns1:OperationalDataInterfaceReferenceRef a owl:Class ;
    rdfs:comment "ReferenceElement InterfaceReference -- points to an AID property (.../InteractionMetadata/properties/{key}) in the same AAS (variables_builder.py hardcodes the properties path segment, never actions/events). Cross-SM target existence enforced via SPARQL SHACL (arso:OperationalDataInterfaceRefTargetShape)." ;
    rdfs:subClassOf <https://admin-shell.io/aas/3/1/ReferenceElement> ;
    ns1:idShort "InterfaceReference" ;
    ns1:parentClass ns1:OperationalDataVariableSMC .

ns1:ParameterInterfaceReferenceRef a owl:Class ;
    rdfs:comment "ReferenceElement InterfaceReference -- points to an AID property (.../InteractionMetadata/properties/{key}) in the same AAS (parameters_builder.py hardcodes the properties path segment, never actions/events). Cross-SM target existence enforced via SPARQL SHACL (arso:ParameterInterfaceRefTargetShape)." ;
    rdfs:subClassOf <https://admin-shell.io/aas/3/1/ReferenceElement> ;
    ns1:idShort "InterfaceReference" ;
    ns1:parentClass ns1:ParameterEntrySMC .

ns1:ProductArticleNumberProperty a owl:Class ;
    rdfs:comment "Property ProductArticleNumberOfManufacturer (xs:string) — unique product identifier of the manufacturer. semanticId: 0112/2///61987#ABA581#007. Optional (0..1)." ;
    rdfs:subClassOf <https://admin-shell.io/aas/3/1/Property> ;
    ns1:semanticId "0112/2///61987#ABA581#007" .

ns1:PropertyCommentMLP a owl:Class ;
    rdfs:comment "MLP PropertyComment — general human-readable description of the property." ;
    rdfs:subClassOf <https://admin-shell.io/aas/3/1/MultiLanguageProperty> ;
    ns1:semanticId "https://admin-shell.io/idta/CapabilityDescription/PropertyComment/1/0" .

ns1:RealizesPropertyRel a owl:Class ;
    rdfs:comment "RelationshipElement RealizesProperty — first: a parameter of this skill; second: a property (PropertyContainer) of a capability this skill realizes (CapabilityRealizedBy). The link the IDTA templates lack: it is where a product value reaches the controller (capability property -> skill parameter, css:isRealizedBySkillParameter)." ;
    rdfs:subClassOf <https://admin-shell.io/aas/3/1/RelationshipElement> ;
    ns1:idShort "RealizesProperty" ;
    ns1:parentClass ns1:SkillSMC .

ns1:SameAsRelationship a owl:Class ;
    rdfs:comment "RelationshipElement SameAs — links two entities representing the same asset, within or across submodels. Both first and second must reference an EntryNodeEntity or NodeEntity." ;
    rdfs:subClassOf <https://admin-shell.io/aas/3/1/RelationshipElement> ;
    ns1:semanticId "https://admin-shell.io/idta/HierarchicalStructures/SameAs/1/0" .

ns1:SamePropertyRel a owl:Class ;
    rdfs:comment "RelationshipElement SameProperty — links the property in this PropertyContainer (first) to an identical property in another Submodel or external source (second)." ;
    rdfs:subClassOf <https://admin-shell.io/aas/3/1/RelationshipElement> ;
    ns1:semanticId "https://admin-shell.io/idta/CapabilityDescription/SameProperty/1/0" .

ns1:SerialNumberProperty a owl:Class ;
    rdfs:comment "Property SerialNumber (xs:string) — unique identifier for the manufactured device. semanticId: 0112/2///61987#ABA951#009. Optional (0..1)." ;
    rdfs:subClassOf <https://admin-shell.io/aas/3/1/Property> ;
    ns1:semanticId "0112/2///61987#ABA951#009" .

ns1:SoftwareVersionProperty a owl:Class ;
    rdfs:comment "Property SoftwareVersion (xs:string) — version of software used by the device. semanticId: 0112/2///61987#ABA601#008. Optional (0..1)." ;
    rdfs:subClassOf <https://admin-shell.io/aas/3/1/Property> ;
    ns1:semanticId "0112/2///61987#ABA601#008" .

ns1:SourcePollingIntervalProperty a owl:Class ;
    rdfs:comment "Property PollingInterval (xs:double) — per-source override of DefaultPollingInterval." ;
    rdfs:subClassOf <https://admin-shell.io/aas/3/1/Property> ;
    ns1:semanticId "https://admin-shell.io/idta/AssetInterfacesMappingConfiguration/2/0/MappingConfiguration/Source/PollingInterval" .

ns1:TechnicalCompanyLogoFile a owl:Class ;
    rdfs:comment "File CompanyLogo — company logo image." ;
    rdfs:subClassOf <https://admin-shell.io/aas/3/1/File> ;
    ns1:semanticId "0173-1#02-ABI776#002" .

ns1:TechnicalImageNoteMLP a owl:Class ;
    rdfs:comment "MLP ImageNote — note or explanation about the product image." ;
    rdfs:subClassOf <https://admin-shell.io/aas/3/1/MultiLanguageProperty> ;
    ns1:semanticId "0173-1#02-ABL423#001" .

ns1:TransformationBlob a owl:Class ;
    rdfs:comment "Blob Transformation — optional payload transformation applied between sources and sinks." ;
    rdfs:subClassOf <https://admin-shell.io/aas/3/1/Blob> ;
    ns1:semanticId "https://admin-shell.io/idta/AssetInterfacesMappingConfiguration/2/0/MappingConfiguration/Transformation" .

ns1:UavEncodingProperty a owl:Class ;
    rdfs:comment "Property encoding (xs:string) — message encoding, typically 'TCP Binary'. OPC UA EndpointMetadata." ;
    rdfs:subClassOf <https://admin-shell.io/aas/3/1/Property> .

ns1:UavNamespaceIndexProperty a owl:Class ;
    rdfs:comment "Property namespace_index (xs:string) — namespace index for application nodes, typically '1'. OPC UA EndpointMetadata." ;
    rdfs:subClassOf <https://admin-shell.io/aas/3/1/Property> .

ns1:UavNamespaceProperty a owl:Class ;
    rdfs:comment "Property opc_namespace (xs:string) — namespace index for the node, e.g. '1'. Used in Forms SMC." ;
    rdfs:subClassOf <https://admin-shell.io/aas/3/1/Property> .

ns1:UavNamespaceUriProperty a owl:Class ;
    rdfs:comment "Property namespace_uri (xs:string) — OPC UA application namespace URI from the NodeSet <NamespaceUri> element. OPC UA EndpointMetadata." ;
    rdfs:subClassOf <https://admin-shell.io/aas/3/1/Property> .

ns1:UavNodeIdProperty a owl:Class ;
    rdfs:comment "Property opc_node_id (xs:string) — full OPC UA NodeId string, e.g. 'ns=1;s=PlungerSet80/Methods/Start'. Used in Forms SMC for actions and properties." ;
    rdfs:subClassOf <https://admin-shell.io/aas/3/1/Property> ;
    ns1:idShort "opc_node_id" ;
    ns1:parentClass ns1:FormsSMC .

ns1:UavPortProperty a owl:Class ;
    rdfs:comment "Property port (xs:string) — OPC UA endpoint port, typically '4840'. OPC UA EndpointMetadata." ;
    rdfs:subClassOf <https://admin-shell.io/aas/3/1/Property> .

ns1:UavProtocolProperty a owl:Class ;
    rdfs:comment "Property protocol (xs:string) — transport protocol, e.g. 'OPC UA'. OPC UA EndpointMetadata." ;
    rdfs:subClassOf <https://admin-shell.io/aas/3/1/Property> .

ns1:UavSecurityModeProperty a owl:Class ;
    rdfs:comment "Property security_mode (xs:string) — OPC UA MessageSecurityMode: None, Sign, or SignAndEncrypt." ;
    rdfs:subClassOf <https://admin-shell.io/aas/3/1/Property> ;
    ns1:semanticId "http://opcfoundation.org/UA/WoT-Binding/securityMode" .

ns1:UavSecurityPolicyProperty a owl:Class ;
    rdfs:comment "Property security_policy (xs:string) — OPC UA SecurityPolicy URI, e.g. Basic256Sha256." ;
    rdfs:subClassOf <https://admin-shell.io/aas/3/1/Property> ;
    ns1:semanticId "http://opcfoundation.org/UA/WoT-Binding/securityPolicy" .

ns1:UavUserIdentityTokenProperty a owl:Class ;
    rdfs:comment "Property user_token_type (xs:string) — OPC UA user identity token type: Anonymous, UserName, Certificate, or IssuedToken." ;
    rdfs:subClassOf <https://admin-shell.io/aas/3/1/Property> ;
    ns1:semanticId "http://opcfoundation.org/UA/WoT-Binding/userIdentityToken" .

ns1:UniqueFacilityIdentifierProperty a owl:Class ;
    rdfs:comment "Property UniqueFacilityIdentifier (xs:string) — unique string for identification of locations/buildings in the product's value chain. semanticId: https://admin-shell.io/idta/nameplate/3/0/UniqueFacilityIdentifier. New in v3.0. Optional (0..1)." ;
    rdfs:subClassOf <https://admin-shell.io/aas/3/1/Property> ;
    ns1:semanticId "https://admin-shell.io/idta/nameplate/3/0/UniqueFacilityIdentifier" .

ns1:YearOfConstructionProperty a owl:Class ;
    rdfs:comment "Property YearOfConstruction (xs:string) — year manufacturing process completed. semanticId: 0112/2///61987#ABP000#002. Optional (0..1); changed from mandatory in v2." ;
    rdfs:subClassOf <https://admin-shell.io/aas/3/1/Property> ;
    ns1:semanticId "0112/2///61987#ABP000#002" .

ns1:idShort a owl:AnnotationProperty ;
    rdfs:label "idShort" ;
    rdfs:comment "The idShort a structurally-typed instance of this class must carry. Used together with arso:parentClass / arso:transitiveParentClass when the element has no semanticId of its own to identify it by." .

ns1:parentClass a owl:AnnotationProperty ;
    rdfs:label "parentClass" ;
    rdfs:comment "Declares this class is found as a direct structural child of the given class, reached via that parent's own AAS containment property (Submodel/submodelElements, SubmodelElementCollection/value, SubmodelElementList/value, or Entity/statements). Combined with arso:idShort when the child needs disambiguating from siblings; when no arso:idShort is given, the class is applied unconditionally to any direct child of that AAS modelType with no other idShort-anchored match." .

ns1:resolvedFrom a owl:AnnotationProperty ;
    rdfs:label "resolvedFrom" ;
    rdfs:comment "On a resolved link: the class of the list whose ReferenceElements the JSON-to-RDF projection resolves into this link. The link runs from the element that holds the list to every element of the same document that one of its references names." .

ns1:semanticId a owl:AnnotationProperty ;
    rdfs:label "semanticId" ;
    rdfs:comment "One or more AAS semanticId values (URI or IRDI) that identify RDF individuals of this class during JSON-to-RDF projection. Multi-valued to cover legacy/variant IDs for the same concept." .

ns1:transitiveParentClass a owl:AnnotationProperty ;
    rdfs:label "transitiveParentClass" ;
    rdfs:comment "Like arso:parentClass, but the child may be reached through one or more untyped intermediate containers rather than being a direct child. Use only when arso:parentClass cannot express the real containment depth." .

ns1:unconditionalAasType a owl:AnnotationProperty ;
    rdfs:label "unconditionalAasType" ;
    rdfs:comment "Explicit opt-in: any RDF node whose base AAS modelType class is the given value is unconditionally also typed as this class, wherever it occurs in the graph -- no parent/idShort scoping at all. Only safe for AAS modelTypes that are inherently specific to one concept (e.g. aas:Capability); NOT a general 'sole ARSO subclass' inference, since a generic modelType like aas:ReferenceElement legitimately has many unrelated ARSO subclasses and must never be auto-applied this way." .

<http://www.w3id.org/hsu-aut/css> a owl:Ontology ;
    rdfs:comment """An ontology for the Capability, Skill and Service reference model defined by Plattform Industrie 4.0. See https://www.plattform-i40.de/IP/Redaktion/DE/Downloads/Publikation/CapabilitiesSkillsServices.html for a description of the abstract reference model.\r
\r
Includes extensions defined in https://www.plattform-i40.de/IP/Redaktion/DE/Downloads/Publikation/2025-i40-capabilities.pdf?__blob=publicationFile&v=5.""" ;
    rdfs:isDefinedBy "https://www.plattform-i40.de/IP/Redaktion/DE/Downloads/Publikation/2025-i40-capabilities.pdf?__blob=publicationFile&v=5",
        "https://www.plattform-i40.de/IP/Redaktion/DE/Downloads/Publikation/CapabilitiesSkillsServices.html" ;
    owl:versionIRI <http://www.w3id.org/hsu-aut/css/2.0.2> .

<http://www.w3id.org/hsu-aut/css#Capability-isRealizedBy> a sh:PropertyShape ;
    sh:path <http://www.w3id.org/hsu-aut/css#isRealizedBy> .

<http://www.w3id.org/hsu-aut/css#Capability-isRealizedBySkill> a sh:PropertyShape ;
    sh:class <http://www.w3id.org/hsu-aut/css#Skill> ;
    sh:path <http://www.w3id.org/hsu-aut/css#isRealizedBySkill> .

<http://www.w3id.org/hsu-aut/css#Capability-isRestrictedBy> a sh:PropertyShape ;
    sh:class <http://www.w3id.org/hsu-aut/css#Constraint> ;
    sh:path <http://www.w3id.org/hsu-aut/css#isRestrictedBy> .

<http://www.w3id.org/hsu-aut/css#Capability-isSpecifiedBy> a sh:PropertyShape ;

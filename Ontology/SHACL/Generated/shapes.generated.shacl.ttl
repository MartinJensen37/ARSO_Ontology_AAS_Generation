    rdfs:domain <https://admin-shell.io/aas/3/1/HasKind> ;
    rdfs:range <https://admin-shell.io/aas/3/1/ModellingKind> .

<https://admin-shell.io/aas/3/1/SubmodelElementList/value> a owl:ObjectProperty ;

ns1:AddressInformationSMC a rdfs:Class,
        owl:Class,
        sh:NodeShape ;
    rdfs:comment "SMC AddressInformation — drop-in from IDTA 02002 (Contact Informations). semanticId: https://admin-shell.io/zvei/nameplate/1/0/ContactInformations/AddressInformation. Mandatory per IDTA 02006-3-0." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://admin-shell.io/aas/3/1/SubmodelElementCollection/value> ;
            owl:someValuesFrom ns1:AddressZipcodeMLP ],
        [ a owl:Restriction ;
            owl:onProperty <https://admin-shell.io/aas/3/1/SubmodelElementCollection/value> ;
            owl:someValuesFrom ns1:AddressCityTownMLP ],
        [ a owl:Restriction ;
            owl:onProperty <https://admin-shell.io/aas/3/1/SubmodelElementCollection/value> ;
            owl:someValuesFrom ns1:AddressNationalCodeMLP ],
        [ a owl:Restriction ;
            owl:onProperty <https://admin-shell.io/aas/3/1/SubmodelElementCollection/value> ;
            owl:someValuesFrom ns1:AddressStreetMLP ],
        <https://admin-shell.io/aas/3/1/SubmodelElementCollection> ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type rdfs:comment rdfs:label <https://admin-shell.io/aas/3/1/HasDataSpecification/embeddedDataSpecifications> <https://admin-shell.io/aas/3/1/HasExtensions/extensions> <https://admin-shell.io/aas/3/1/HasSemantics/semanticId> <https://admin-shell.io/aas/3/1/HasSemantics/supplementalSemanticIds> <https://admin-shell.io/aas/3/1/Qualifiable/qualifiers> <https://admin-shell.io/aas/3/1/Referable/category> <https://admin-shell.io/aas/3/1/Referable/description> <https://admin-shell.io/aas/3/1/Referable/displayName> <https://admin-shell.io/aas/3/1/Referable/idShort> ) ;
    sh:property ns1:AddressInformationSMC-https___admin-shell.io_aas_3_1_SubmodelElementCollection_value ;
    ns1:semanticId "https://admin-shell.io/zvei/nameplate/1/0/ContactInformations/AddressInformation",
        "https://admin-shell.io/zvei/nameplate/1/0/Nameplate/ContactInformation" .

ns1:ArcheTypeProperty a rdfs:Class,
        owl:Class,
        sh:NodeShape ;
    rdfs:comment "Property ArcheType (xs:string) — hierarchy archetype: 'Full', 'OneDown', or 'OneUp'. The value enumeration is enforced by arso:ArcheTypeValueShape in arso-rules.shacl.ttl, NOT by the owl:oneOf restriction below: the owl2shacl ruleset does not translate owl:oneOf into sh:in (verified -- zero sh:in in the generated shapes), so the restriction alone is inert." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:oneOf ( "Full" "OneDown" "OneUp" ) ] ;
            owl:onProperty <https://admin-shell.io/aas/3/1/Property/value> ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty <https://admin-shell.io/aas/3/1/Property/value> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://admin-shell.io/aas/3/1/Property/value> ],
        <https://admin-shell.io/aas/3/1/Property> ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type rdfs:comment rdfs:label <https://admin-shell.io/aas/3/1/HasDataSpecification/embeddedDataSpecifications> <https://admin-shell.io/aas/3/1/HasExtensions/extensions> <https://admin-shell.io/aas/3/1/HasSemantics/semanticId> <https://admin-shell.io/aas/3/1/HasSemantics/supplementalSemanticIds> <https://admin-shell.io/aas/3/1/Property/valueId> <https://admin-shell.io/aas/3/1/Property/valueType> <https://admin-shell.io/aas/3/1/Qualifiable/qualifiers> <https://admin-shell.io/aas/3/1/Referable/category> <https://admin-shell.io/aas/3/1/Referable/description> <https://admin-shell.io/aas/3/1/Referable/displayName> <https://admin-shell.io/aas/3/1/Referable/idShort> ) ;
    sh:property ns1:ArcheTypeProperty-https___admin-shell.io_aas_3_1_Property_value ;
    ns1:semanticId "https://admin-shell.io/idta/HierarchicalStructures/ArcheType/1/0" .

ns1:AssetSpecificPropertiesSMC a rdfs:Class,
        owl:Class,
        sh:NodeShape ;
    rdfs:comment "SMC AssetSpecificProperties — asset-specific nameplate properties not covered by the standard structure. semanticId: 0173-1#02-ABI218#003/0173-1#01-AGZ672#004. Optional (0..1)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ns1:GuidelineSpecificPropertiesSML ;
            owl:onProperty <https://admin-shell.io/aas/3/1/SubmodelElementCollection/value> ],
        <https://admin-shell.io/aas/3/1/SubmodelElementCollection> ;

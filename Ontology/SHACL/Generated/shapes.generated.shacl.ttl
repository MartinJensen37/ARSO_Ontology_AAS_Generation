    rdfs:domain <https://admin-shell.io/aas/3/1/ConceptDescription> ;
    rdfs:range <https://admin-shell.io/aas/3/1/Reference> .

ns1:SkillParametersSMC a owl:Class ;
    rdfs:comment "SMC Parameters — the skill's parameters as Properties (css:SkillParameter); value is the current (deployed) value, qualifiers Unit, Minimum, Maximum and Default the declaration." ;
    rdfs:subClassOf <https://admin-shell.io/aas/3/1/SubmodelElementCollection> ;
    ns1:idShort "Parameters" ;
    ns1:parentClass ns1:BuildingBlockSMC,
        ns1:SkillSMC .


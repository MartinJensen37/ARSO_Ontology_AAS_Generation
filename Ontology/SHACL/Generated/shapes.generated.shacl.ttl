                    owl:unionOf ( ns1:TechnicalGeneralInformationSMC ns1:TechnicalProductClassificationsSML ns1:TechnicalPropertyAreasSML ns1:TechnicalFurtherInformationSMC ns1:TechnicalSpecificDescriptionsSML ) ] ;

<https://admin-shell.io/aas/3/1/Referable/idShort> a owl:DatatypeProperty ;
    rdfs:label "has ID short"^^xsd:string ;
    rdfs:comment "In case of identifiables this attribute is a short name of the element. In case of referable this ID is an identifying string of the element within its name space."@en ;
    rdfs:domain <https://admin-shell.io/aas/3/1/Referable> ;
    rdfs:range xsd:string .

<https://admin-shell.io/aas/3/1/HasDataSpecification/embeddedDataSpecifications> a owl:ObjectProperty ;

    rdfs:domain <https://admin-shell.io/aas/3/1/HasSemantics> ;
    rdfs:range <https://admin-shell.io/aas/3/1/Reference> .

<https://admin-shell.io/aas/3/1/Referable/category> a owl:DatatypeProperty ;
    rdfs:label "has category"^^xsd:string ;
    rdfs:comment "The category is a value that gives further meta information w.r.t. to the class of the element. It affects the expected existence of attributes and the applicability of constraints."@en ;
    rdfs:domain <https://admin-shell.io/aas/3/1/Referable> ;
    rdfs:range xsd:string .

<https://admin-shell.io/aas/3/1/Referable/description> a owl:ObjectProperty ;

ns1:SkillImplementationSMC a rdfs:Class,
        owl:Class,
        sh:NodeShape ;
    rdfs:comment "SMC Implementation — the runtime block implementing the skill: FBType (qualified IEC 61499 type), TypeHash (as the runtime reports it) and InstancePath (dotted instance name). Lets a reader check that the described skill is the deployed one." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass ns1:ImplementationFBTypeProperty ;
            owl:onProperty <https://admin-shell.io/aas/3/1/SubmodelElementCollection/value> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ns1:ImplementationTypeHashProperty ;
            owl:onProperty <https://admin-shell.io/aas/3/1/SubmodelElementCollection/value> ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ns1:ImplementationInstancePathProperty ;
            owl:onProperty <https://admin-shell.io/aas/3/1/SubmodelElementCollection/value> ],
        <https://admin-shell.io/aas/3/1/SubmodelElementCollection> ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type rdfs:comment rdfs:label <https://admin-shell.io/aas/3/1/HasDataSpecification/embeddedDataSpecifications> <https://admin-shell.io/aas/3/1/HasExtensions/extensions> <https://admin-shell.io/aas/3/1/HasSemantics/semanticId> <https://admin-shell.io/aas/3/1/HasSemantics/supplementalSemanticIds> <https://admin-shell.io/aas/3/1/Qualifiable/qualifiers> <https://admin-shell.io/aas/3/1/Referable/category> <https://admin-shell.io/aas/3/1/Referable/description> <https://admin-shell.io/aas/3/1/Referable/displayName> <https://admin-shell.io/aas/3/1/Referable/idShort> ) ;
    sh:property [ a sh:PropertyShape ;
            sh:path <https://admin-shell.io/aas/3/1/SubmodelElementCollection/value> ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:class ns1:ImplementationFBTypeProperty ] ],
        [ a sh:PropertyShape ;
            sh:path <https://admin-shell.io/aas/3/1/SubmodelElementCollection/value> ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:class ns1:ImplementationTypeHashProperty ] ],
        [ a sh:PropertyShape ;
            sh:path <https://admin-shell.io/aas/3/1/SubmodelElementCollection/value> ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:class ns1:ImplementationInstancePathProperty ] ],
        ns1:SkillImplementationSMC-https___admin-shell.io_aas_3_1_SubmodelElementCollection_value ;
    ns1:idShort "Implementation" ;
    ns1:parentClass ns1:BuildingBlockSMC,
        ns1:SkillSMC .

ns1:SkillParameterProperty a rdfs:Class,
        owl:Class,
        sh:NodeShape ;
    rdfs:comment "Property {parameter} — one skill parameter (css:InputParameter). Applied to every Property directly in Parameters." ;
    rdfs:subClassOf <https://admin-shell.io/aas/3/1/Property> ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type rdfs:comment rdfs:label <https://admin-shell.io/aas/3/1/HasDataSpecification/embeddedDataSpecifications> <https://admin-shell.io/aas/3/1/HasExtensions/extensions> <https://admin-shell.io/aas/3/1/HasSemantics/semanticId> <https://admin-shell.io/aas/3/1/HasSemantics/supplementalSemanticIds> <https://admin-shell.io/aas/3/1/Property/value> <https://admin-shell.io/aas/3/1/Property/valueId> <https://admin-shell.io/aas/3/1/Property/valueType> <https://admin-shell.io/aas/3/1/Qualifiable/qualifiers> <https://admin-shell.io/aas/3/1/Referable/category> <https://admin-shell.io/aas/3/1/Referable/description> <https://admin-shell.io/aas/3/1/Referable/displayName> <https://admin-shell.io/aas/3/1/Referable/idShort> ) ;
    sh:property ns1:SkillParameterProperty-realizesProperty ;
    ns1:parentClass ns1:SkillParametersSMC .

ns1:SkillSMC a rdfs:Class,
        owl:Class,
        sh:NodeShape ;
    rdfs:comment "SMC {skill_name} — a named skill. Applied unconditionally to every direct child of Skills (no idShort — the skill name is user-defined). Contains SemanticId, an Operation, and an InterfaceReference (all mandatory), plus an optional StateMachine for asynchronous skills." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ns1:SkillContractSMC ;
            owl:onProperty <https://admin-shell.io/aas/3/1/SubmodelElementCollection/value> ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ns1:SkillUsesSML ;
            owl:onProperty <https://admin-shell.io/aas/3/1/SubmodelElementCollection/value> ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ns1:SkillOccupiesSML ;
            owl:onProperty <https://admin-shell.io/aas/3/1/SubmodelElementCollection/value> ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ns1:SkillStateReferenceRef ;
            owl:onProperty <https://admin-shell.io/aas/3/1/SubmodelElementCollection/value> ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ns1:SkillImplementationSMC ;
            owl:onProperty <https://admin-shell.io/aas/3/1/SubmodelElementCollection/value> ],
        [ a owl:Restriction ;
            owl:onProperty <https://admin-shell.io/aas/3/1/SubmodelElementCollection/value> ;
            owl:someValuesFrom ns1:SkillSemanticIdProperty ],
        [ a owl:Restriction ;
            owl:onProperty <https://admin-shell.io/aas/3/1/SubmodelElementCollection/value> ;
            owl:someValuesFrom ns1:SkillOperationElement ],
        [ a owl:Restriction ;
            owl:onProperty <https://admin-shell.io/aas/3/1/SubmodelElementCollection/value> ;
            owl:someValuesFrom ns1:SkillInterfaceReferenceRef ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ns1:SkillStateMachineProperty ;
            owl:onProperty <https://admin-shell.io/aas/3/1/SubmodelElementCollection/value> ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ns1:SkillKindProperty ;
            owl:onProperty <https://admin-shell.io/aas/3/1/SubmodelElementCollection/value> ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ns1:SkillParametersSMC ;
            owl:onProperty <https://admin-shell.io/aas/3/1/SubmodelElementCollection/value> ],
        <https://admin-shell.io/aas/3/1/SubmodelElementCollection> ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type rdfs:comment rdfs:label <https://admin-shell.io/aas/3/1/HasDataSpecification/embeddedDataSpecifications> <https://admin-shell.io/aas/3/1/HasExtensions/extensions> <https://admin-shell.io/aas/3/1/HasSemantics/semanticId> <https://admin-shell.io/aas/3/1/HasSemantics/supplementalSemanticIds> <https://admin-shell.io/aas/3/1/Qualifiable/qualifiers> <https://admin-shell.io/aas/3/1/Referable/category> <https://admin-shell.io/aas/3/1/Referable/description> <https://admin-shell.io/aas/3/1/Referable/displayName> <https://admin-shell.io/aas/3/1/Referable/idShort> ) ;
    sh:property [ a sh:PropertyShape ;
            sh:path <https://admin-shell.io/aas/3/1/SubmodelElementCollection/value> ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:class ns1:SkillStateMachineProperty ] ],
        [ a sh:PropertyShape ;
            sh:path <https://admin-shell.io/aas/3/1/SubmodelElementCollection/value> ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:class ns1:SkillKindProperty ] ],
        [ a sh:PropertyShape ;
            sh:path <https://admin-shell.io/aas/3/1/SubmodelElementCollection/value> ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:class ns1:SkillStateReferenceRef ] ],
        [ a sh:PropertyShape ;
            sh:path <https://admin-shell.io/aas/3/1/SubmodelElementCollection/value> ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:class ns1:SkillOccupiesSML ] ],
        [ a sh:PropertyShape ;
            sh:path <https://admin-shell.io/aas/3/1/SubmodelElementCollection/value> ;

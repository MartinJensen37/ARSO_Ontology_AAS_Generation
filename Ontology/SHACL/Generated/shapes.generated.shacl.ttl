<http://www.w3id.org/hsu-aut/css#InputParameter> a owl:Class ;
    rdfs:subClassOf <http://www.w3id.org/hsu-aut/css#SkillParameter> .

<http://www.w3id.org/hsu-aut/css#OutputParameter> a owl:Class ;
    rdfs:subClassOf <http://www.w3id.org/hsu-aut/css#SkillParameter> .

<https://w3id.org/2025/arso> a owl:Ontology ;
    rdfs:comment """ARSO v0.6 — Domain extension ontology for Resource AAS.\r
\r
  v0.6 (7 Oct 2026): building blocks (the skill primitives a resource does not offer), what an\r
  Implementation and a Contract hold, the rule set a program is built by (Control Configuration),\r
  usesSkill resolved from a skill's Uses (arso:resolvedFrom), and a parameter entry's Value optional.\r
\r
  v0.5 (30 Sep 2026): optional reconfiguration elements per skill (control-component:\r
  Parameters, RealizesProperty, Contract, Uses, Execute/Stop, Occupies, Implementation),\r
  a Control Configuration submodel, and resolved cross-submodel links for them below.\r
  Relations to products and processes live in the PPR link ontology (pprl).\r
\r
\r
  This ontology:\r
    - imports the official AAS v3.1 ontology for structural validation\r
    - imports per-submodel modules that define element types and internal constraints\r
    - defines the CSS Resource ↔ AAS link and cross-submodel dependencies here\r
    - uses AAS properties (submodelElements, value, etc.) for containment\r
    - adds arso: properties only for cross-submodel dependency checks\r
\r
  Structural/formatting validation is handled by the AAS ontology + SHACL.\r
  This ontology adds ONLY domain-specific constraints on top.""" ;
    owl:imports <http://www.w3id.org/hsu-aut/css>,
        <https://admin-shell.io/aas/3/1/>,
        <https://w3id.org/2025/arso/modules/aid>,
        <https://w3id.org/2025/arso/modules/aimc>,
        <https://w3id.org/2025/arso/modules/capabilities>,
        <https://w3id.org/2025/arso/modules/control-component>,
        <https://w3id.org/2025/arso/modules/control-configuration>,
        <https://w3id.org/2025/arso/modules/hierarchical-structures>,
        <https://w3id.org/2025/arso/modules/nameplate>,
        <https://w3id.org/2025/arso/modules/operational-data>,
        <https://w3id.org/2025/arso/modules/parameters>,
        <https://w3id.org/2025/arso/modules/technical-data> ;
    owl:versionIRI <https://w3id.org/2025/arso/0.6.0> .

ns1:AIMCInterfaceReferenceRef a owl:Class ;
    rdfs:comment "ReferenceElement InterfaceReference -- the AID interface SMC this configuration maps. Cross-submodel target enforced via SPARQL SHACL." ;
    rdfs:subClassOf <https://admin-shell.io/aas/3/1/ReferenceElement> ;
    ns1:idShort "InterfaceReference" ;
    ns1:parentClass ns1:MappingConfigurationSMC .

ns1:BuildingBlockResultProperty a owl:Class ;
    rdfs:comment "Property {result} — one result: its valueType, and the qualifier Unit. Applied to every Property directly in Results." ;
    rdfs:subClassOf <https://admin-shell.io/aas/3/1/Property> ;
    ns1:parentClass ns1:BuildingBlockResultsSMC .

ns1:CCfgChangeSMC a owl:Class ;
    rdfs:comment "SMC Change — one reconfiguration record." ;
    rdfs:subClassOf <https://admin-shell.io/aas/3/1/SubmodelElementCollection> ;
    ns1:parentClass ns1:CCfgChangeLogSML .

ns1:CCfgDifferenceProperty a owl:Class ;
    rdfs:comment "Property D001.. — one difference (v0.6)." ;
    rdfs:subClassOf <https://admin-shell.io/aas/3/1/Property> ;
    ns1:parentClass ns1:CCfgDifferencesSMC .

ns1:CCfgRuntimeDetailProperty a owl:Class ;
    rdfs:comment "Property Name, ManagementEndpoint or Resource of the runtime (v0.6)." ;
    rdfs:subClassOf <https://admin-shell.io/aas/3/1/Property> ;
    ns1:idShort "ManagementEndpoint",
        "Name",
        "Resource" ;
    ns1:parentClass ns1:CCfgRuntimeSMC .

ns1:CCfgSourceProperty a owl:Class ;
    rdfs:comment "Property ModuleSpec, Target, Generator (what the program was generated from and by), ProgramDigest (SHA-256 of the generated program: instances, types, connections, values) or ReadAt (when the controller was read) (v0.6)." ;
    rdfs:subClassOf <https://admin-shell.io/aas/3/1/Property> ;
    ns1:idShort "Generator",
        "ModuleSpec",
        "ProgramDigest",
        "ReadAt",
        "Target" ;
    ns1:parentClass ns1:ControlConfigurationSubmodel .

ns1:CCfgTypeDetailProperty a owl:Class ;
    rdfs:comment "Property Name or Hash of a type, as the runtime reports them (v0.6)." ;
    rdfs:subClassOf <https://admin-shell.io/aas/3/1/Property> ;
    ns1:idShort "Hash",
        "Name" ;
    ns1:parentClass ns1:CCfgTypeSMC .

ns1:CapabilityCommentMLP a owl:Class ;
    rdfs:comment "MLP CapabilityComment — individual human-readable comment for the capability." ;
    rdfs:subClassOf <https://admin-shell.io/aas/3/1/MultiLanguageProperty> ;
    ns1:semanticId "https://admin-shell.io/idta/CapabilityDescription/CapabilityComment/1/0" .

ns1:CapabilityComposedOfRel a owl:Class ;
    rdfs:comment "RelationshipElement CapabilityComposedOf — first: composed capability; second: one of its sub-capabilities. Minimum 2 per ComposedOfContainer." ;
    rdfs:subClassOf <https://admin-shell.io/aas/3/1/RelationshipElement> ;
    ns1:semanticId "https://admin-shell.io/idta/CapabilityDescription/CapabilityComposedOf/1/0" .

ns1:CapabilityRealizedByRel a owl:Class ;
    rdfs:comment "RelationshipElement CapabilityRealizedBy — first: Capability in this SM; second: Skill in the Skills Submodel of the same AAS. Cross-SM enforcement via SPARQL SHACL. Applied unconditionally to every direct child of a CapabilityRealizedBySML (no idShort — SML entries are unnamed list items)." ;
    rdfs:subClassOf <https://admin-shell.io/aas/3/1/RelationshipElement> ;
    ns1:parentClass ns1:CapabilityRealizedBySML .

ns1:CompanyLogoFile a owl:Class ;

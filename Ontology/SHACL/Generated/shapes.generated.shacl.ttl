ns1:SkillKindProperty a owl:Class ;
    rdfs:comment "Property Kind (xs:string) — Primitive (one function of one equipment item, with a contract) or Composite (a sequence of other skills). Value enumeration enforced in SHACL." ;
    rdfs:subClassOf <https://admin-shell.io/aas/3/1/Property> ;
    ns1:idShort "Kind" ;
    ns1:parentClass ns1:BuildingBlockSMC,
        ns1:SkillSMC .

ns1:SkillOccupiesSML a owl:Class ;
    rdfs:comment "SML Occupies — references to HierarchicalStructures nodes (equipment) the skill locks while it runs; two skills occupying one node never run at once." ;
    rdfs:subClassOf <https://admin-shell.io/aas/3/1/SubmodelElementList> ;
    ns1:idShort "Occupies" ;
    ns1:parentClass ns1:BuildingBlockSMC,
        ns1:SkillSMC .

ns1:SkillSemanticIdProperty a owl:Class ;
    rdfs:comment "Property SemanticId (xs:string) — the skill's own semantic identifier URI (lab namespace convention, enforced via SHACL sh:pattern)." ;
    rdfs:subClassOf <https://admin-shell.io/aas/3/1/Property> ;
    ns1:idShort "SemanticId" ;
    ns1:parentClass ns1:BuildingBlockSMC,
        ns1:SkillSMC .

ns1:TechnicalPropertyAreaSMC a owl:Class ;

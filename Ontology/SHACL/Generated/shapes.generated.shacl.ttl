    rdfs:subClassOf <https://admin-shell.io/aas/3/1/AbstractLangString> .

<https://admin-shell.io/aas/3/1/Qualifier/kind> a owl:ObjectProperty ;
    rdfs:label "has kind"^^xsd:string ;
    rdfs:comment "The qualifier kind describes the kind of the qualifier that is applied to the element."@en ;
    rdfs:domain <https://admin-shell.io/aas/3/1/Qualifier> ;
    rdfs:range <https://admin-shell.io/aas/3/1/QualifierKind> .

<https://admin-shell.io/aas/3/1/Qualifier/type> a owl:DatatypeProperty ;
    rdfs:label "has type"^^xsd:string ;
    rdfs:comment "The qualifier type describes the type of the qualifier that is applied to the element."@en ;
    rdfs:domain <https://admin-shell.io/aas/3/1/Qualifier> ;
    rdfs:range xsd:string .

<https://admin-shell.io/aas/3/1/Qualifier/value> a owl:DatatypeProperty ;
    rdfs:label "has value"^^xsd:string ;
    rdfs:comment "The qualifier value is the value of the qualifier."@en ;
    rdfs:domain <https://admin-shell.io/aas/3/1/Qualifier> ;
    rdfs:range xsd:string .

<https://admin-shell.io/aas/3/1/Qualifier/valueId> a owl:ObjectProperty ;
    rdfs:label "has value ID"^^xsd:string ;
    rdfs:comment "Reference to the global unique ID of a coded value."@en ;
    rdfs:domain <https://admin-shell.io/aas/3/1/Qualifier> ;
    rdfs:range <https://admin-shell.io/aas/3/1/Reference> .

<https://admin-shell.io/aas/3/1/Qualifier/valueType> a owl:ObjectProperty ;
    rdfs:label "has value type"^^xsd:string ;
    rdfs:comment "Data type of the qualifier value."@en ;
    rdfs:domain <https://admin-shell.io/aas/3/1/Qualifier> ;
    rdfs:range <https://admin-shell.io/aas/3/1/DataTypeDefXsd> .

<https://admin-shell.io/aas/3/1/SpecificAssetId/externalSubjectId> a owl:ObjectProperty ;
    rdfs:label "has external subject ID"^^xsd:string ;
    rdfs:comment "The (external) subject the key belongs to or has meaning to."@en ;
    rdfs:domain <https://admin-shell.io/aas/3/1/SpecificAssetId> ;
    rdfs:range <https://admin-shell.io/aas/3/1/Reference> .

<https://admin-shell.io/aas/3/1/SpecificAssetId/name> a owl:DatatypeProperty ;
    rdfs:label "has name"^^xsd:string ;
    rdfs:comment "Name of the identifier"@en ;
    rdfs:domain <https://admin-shell.io/aas/3/1/SpecificAssetId> ;
    rdfs:range xsd:string .

<https://admin-shell.io/aas/3/1/SpecificAssetId/value> a owl:DatatypeProperty ;
    rdfs:label "has value"^^xsd:string ;
    rdfs:comment "The value of the specific asset identifier with the corresponding name."@en ;
    rdfs:domain <https://admin-shell.io/aas/3/1/SpecificAssetId> ;
    rdfs:range xsd:string .

ns1:AddressCityTownMLP a owl:Class ;
    rdfs:comment "MLP CityTown within AddressInformation — mandatory per section 3.2. semanticId: 0173-1#02-AAO132#002." ;
    rdfs:subClassOf <https://admin-shell.io/aas/3/1/MultiLanguageProperty> ;
    ns1:semanticId "0173-1#02-AAO132#002" .

ns1:AddressNationalCodeMLP a owl:Class ;
    rdfs:comment "MLP NationalCode within AddressInformation — mandatory per section 3.2. semanticId: 0173-1#02-AAO134#002." ;
    rdfs:subClassOf <https://admin-shell.io/aas/3/1/MultiLanguageProperty> ;
    ns1:semanticId "0173-1#02-AAO134#002" .

ns1:AddressStreetMLP a owl:Class ;
    rdfs:comment "MLP Street within AddressInformation — mandatory per section 3.2. semanticId: 0173-1#02-AAO128#002." ;
    rdfs:subClassOf <https://admin-shell.io/aas/3/1/MultiLanguageProperty> ;
    ns1:semanticId "0173-1#02-AAO128#002" .

ns1:AddressZipcodeMLP a owl:Class ;
    rdfs:comment "MLP Zipcode within AddressInformation — mandatory per section 3.2. semanticId: 0173-1#02-AAO129#002." ;
    rdfs:subClassOf <https://admin-shell.io/aas/3/1/MultiLanguageProperty> ;
    ns1:semanticId "0173-1#02-AAO129#002" .

ns1:BulkCountProperty a owl:Class ;
    rdfs:comment "Property BulkCount (xs:unsignedLong) — count of identical bulk items represented by this node. Only valid on NodeEntity; presence implies the node represents a type-level asset, not a specific instance." ;
    rdfs:subClassOf <https://admin-shell.io/aas/3/1/Property> ;
    ns1:semanticId "https://admin-shell.io/idta/HierarchicalStructures/BulkCount/1/0" .

ns1:CCInterfacesSMC a owl:Class ;
    rdfs:comment "SMC Interfaces — mandatory top-level container, always present and always empty. ARSO handles interface binding per-skill via each SkillSMC's own InterfaceReference (see design note above), not via device-level entries here." ;
    rdfs:subClassOf <https://admin-shell.io/aas/3/1/SubmodelElementCollection> ;
    ns1:idShort "Interfaces" ;
    ns1:parentClass ns1:SkillsSubmodel .

ns1:CCfgActiveProcedureSMC a owl:Class ;
    rdfs:comment "SMC ActiveProcedure — reference to the Process AAS (and version) whose procedure is active, with NetworkHash, BootFileHash, ActivatedAt." ;
    rdfs:subClassOf <https://admin-shell.io/aas/3/1/SubmodelElementCollection> ;
    ns1:idShort "ActiveProcedure" ;
    ns1:parentClass ns1:ControlConfigurationSubmodel .

ns1:CCfgRulesProperty a owl:Class ;
    rdfs:comment "Property Rules (xs:string) — the IRI of the rule set the resource's program is built by: its shell, the interface of a skill primitive and the pattern of a composite skill. A tool that knows the rule set can verify the program and give it a new skill; whoever built the program is then of no concern (v0.6)." ;
    rdfs:subClassOf <https://admin-shell.io/aas/3/1/Property> ;
    ns1:idShort "Rules" ;
    ns1:parentClass ns1:ControlConfigurationSubmodel .

ns1:CCfgSyncStateProperty a owl:Class ;
    rdfs:comment "Property SyncState — InSync (the running program is the one its source generates), Drift (it differs, see Differences), NoProgram, NotRead (described from the source only)." ;
    rdfs:subClassOf <https://admin-shell.io/aas/3/1/Property> ;
    ns1:idShort "SyncState" ;
    ns1:parentClass ns1:ControlConfigurationSubmodel .

ns1:CapabilityElement a owl:Class ;
    rdfs:comment "Capability element — implementation-independent specification of a function in industrial production. semanticId: https://admin-shell.io/idta/CapabilityDescription/Capability/1/0. Qualified by CapabilityRoleQualifier (Required|Offered|NotAssigned). aas:Capability is a modelType specific to this one concept, so any node of that type anywhere is typed as this class even without a matching semanticId (real fixtures typically use a project-specific Capability URI instead)." ;
    rdfs:subClassOf <https://admin-shell.io/aas/3/1/Capability> ;
    ns1:semanticId "https://admin-shell.io/idta/CapabilityDescription/Capability/1/0" ;
    ns1:unconditionalAasType <https://admin-shell.io/aas/3/1/Capability> .

ns1:CapabilityGeneralizedByRel a owl:Class ;
    rdfs:comment "RelationshipElement CapabilityGeneralizedBy — first: this capability (to be generalized); second: a more general capability." ;
    rdfs:subClassOf <https://admin-shell.io/aas/3/1/RelationshipElement> ;
    ns1:semanticId "https://admin-shell.io/idta/CapabilityDescription/CapabilityGeneralizedBy/1/0" .

ns1:ComposedOfContainerSMC a owl:Class ;
    rdfs:comment "SMC ComposedOfContainer — one composition record; must contain at least 2 CapabilityComposedOf relationships." ;
    rdfs:subClassOf <https://admin-shell.io/aas/3/1/SubmodelElementCollection> ;
    ns1:semanticId "https://admin-shell.io/idta/CapabilityDescription/ComposedOfContainer/1/0" .

ns1:ConstraintHasPropertyRel a owl:Class ;
    rdfs:comment "RelationshipElement ConstraintHasProperty — first: PropertyConstraint; second: Property from a PropertyContainer." ;
    rdfs:subClassOf <https://admin-shell.io/aas/3/1/RelationshipElement> ;
    ns1:semanticId "https://admin-shell.io/idta/CapabilityDescription/ConstraintHasProperty/1/0" .

ns1:ContractAfterProperty a owl:Class ;
    rdfs:comment "Property After (xs:string) — the open-loop duration: the skill has succeeded when it has passed, in seconds (a time ends it). An expression over the resource's state variables and the skill's parameters, or a duration (v0.6)." ;
    rdfs:subClassOf <https://admin-shell.io/aas/3/1/Property> ;
    ns1:idShort "After" ;
    ns1:parentClass ns1:SkillContractSMC .

ns1:ContractEnsuresProperty a owl:Class ;
    rdfs:comment "Property Ensures (xs:string) — the postcondition: the skill has succeeded when it holds (a sensor ends it). An expression over the resource's state variables and the skill's parameters, or a duration (v0.6)." ;
    rdfs:subClassOf <https://admin-shell.io/aas/3/1/Property> ;
    ns1:idShort "Ensures" ;
    ns1:parentClass ns1:SkillContractSMC .

ns1:ContractInvariantProperty a owl:Class ;
    rdfs:comment "Property Invariant (xs:string) — what has to hold all the while the skill runs. An expression over the resource's state variables and the skill's parameters, or a duration (v0.6)." ;
    rdfs:subClassOf <https://admin-shell.io/aas/3/1/Property> ;
    ns1:idShort "Invariant" ;
    ns1:parentClass ns1:SkillContractSMC .

ns1:ContractRequiresProperty a owl:Class ;
    rdfs:comment "Property Requires (xs:string) — the precondition: what has to hold when the skill starts. An expression over the resource's state variables and the skill's parameters, or a duration (v0.6)." ;
    rdfs:subClassOf <https://admin-shell.io/aas/3/1/Property> ;
    ns1:idShort "Requires" ;
    ns1:parentClass ns1:SkillContractSMC .

ns1:ContractTimeoutProperty a owl:Class ;
    rdfs:comment "Property Timeout (xs:string) — the longest the skill may run. An expression over the resource's state variables and the skill's parameters, or a duration (v0.6)." ;
    rdfs:subClassOf <https://admin-shell.io/aas/3/1/Property> ;
    ns1:idShort "Timeout" ;
    ns1:parentClass ns1:SkillContractSMC .

ns1:EndpointBaseProperty a owl:Class ;
    rdfs:comment "Property base (xs:anyURI) — base URI for all forms in this Interface." ;
    rdfs:subClassOf <https://admin-shell.io/aas/3/1/Property> ;
    ns1:idShort "base" ;
    ns1:parentClass ns1:EndpointMetadataSMC ;
    ns1:semanticId "https://www.w3.org/2019/wot/td#baseURI" .

ns1:ErrorCodeProperty a owl:Class ;
    rdfs:comment "Property ErrorCode (xs:integer) — numeric error code identifying this error." ;
    rdfs:subClassOf <https://admin-shell.io/aas/3/1/Property> ;
    ns1:idShort "ErrorCode" ;
    ns1:parentClass ns1:ErrorSMC .

ns1:ExternalDescriptorFile a owl:Class ;
    rdfs:comment "File within ExternalDescriptor — path to an external TD document." ;
    rdfs:subClassOf <https://admin-shell.io/aas/3/1/File> ;
    ns1:parentClass ns1:ExternalDescriptorSMC ;
    ns1:semanticId "https://admin-shell.io/idta/AssetInterfacesDescription/1/0/externalDescriptorName" .

ns1:GuidelineForConformityDeclarationProperty a owl:Class ;
    rdfs:comment "Property GuidelineForConformityDeclaration (xs:string) — guideline/stipulation/legislation used for conformity determination. semanticId: 0173-1#02-AAO856#002. Mandatory within GuidelineSpecificPropertiesSMC." ;
    rdfs:subClassOf <https://admin-shell.io/aas/3/1/Property> ;
    ns1:semanticId "0173-1#02-AAO856#002" .

ns1:ImplementationFBTypeProperty a owl:Class ;
    rdfs:comment "Property FBType (xs:string) — the qualified IEC 61499 type of the block. A step that runs the skill is an instance of this type (v0.6)." ;
    rdfs:subClassOf <https://admin-shell.io/aas/3/1/Property> ;
    ns1:idShort "FBType" ;
    ns1:parentClass ns1:SkillImplementationSMC .

ns1:ImplementationInstancePathProperty a owl:Class ;
    rdfs:comment "Property InstancePath (xs:string) — the dotted name of the instance that is the skill. A building block has none: it has instances only as steps (v0.6)." ;
    rdfs:subClassOf <https://admin-shell.io/aas/3/1/Property> ;
    ns1:idShort "InstancePath" ;
    ns1:parentClass ns1:SkillImplementationSMC .

ns1:ImplementationTypeHashProperty a owl:Class ;
    rdfs:comment "Property TypeHash (xs:string) — the hash of the type as the runtime reports it; there when the resource was read (v0.6)." ;
    rdfs:subClassOf <https://admin-shell.io/aas/3/1/Property> ;
    ns1:idShort "TypeHash" ;
    ns1:parentClass ns1:SkillImplementationSMC .

ns1:InterfaceTitleProperty a owl:Class ;
    rdfs:comment "Property title (xs:string) — human-readable name of the Interface." ;
    rdfs:subClassOf <https://admin-shell.io/aas/3/1/Property> ;
    ns1:idShort "title" ;
    ns1:parentClass ns1:InterfaceSMC ;
    ns1:semanticId "https://www.w3.org/2019/wot/td#title" .

ns1:ManufacturerNameMLP a owl:Class ;
    rdfs:comment "MLP ManufacturerName — legally valid designation of the manufacturer. semanticId: 0112/2///61987#ABA565#009. Mandatory." ;
    rdfs:subClassOf <https://admin-shell.io/aas/3/1/MultiLanguageProperty> ;
    ns1:semanticId "0112/2///61987#ABA565#009",
        "https://admin-shell.io/zvei/nameplate/1/0/Nameplate/ManufacturerName" .

ns1:ManufacturerProductDesignationMLP a owl:Class ;
    rdfs:comment "MLP ManufacturerProductDesignation — short description of the product. semanticId: 0112/2///61987#ABA567#009. Mandatory." ;
    rdfs:subClassOf <https://admin-shell.io/aas/3/1/MultiLanguageProperty> ;
    ns1:semanticId "0112/2///61987#ABA567#009",
        "https://admin-shell.io/zvei/nameplate/1/0/Nameplate/ManufacturerProductDesignation" .

ns1:MappingConfigurationsSML a owl:Class ;
    rdfs:comment "SML MappingConfigurations — the single list holding every mapping configuration." ;
    rdfs:subClassOf <https://admin-shell.io/aas/3/1/SubmodelElementList> ;
    ns1:semanticId "https://admin-shell.io/idta/AssetInterfacesMappingConfiguration/1/0/MappingConfigurations" .

ns1:MarkingFileFile a owl:Class ;
    rdfs:comment "File MarkingFile — conformity symbol image of the marking. semanticId: 0112/2///61987#ABO100#002. Mandatory within MarkingSMC." ;
    rdfs:subClassOf <https://admin-shell.io/aas/3/1/File> ;
    ns1:semanticId "0112/2///61987#ABO100#002" .

ns1:MarkingNameProperty a owl:Class ;
    rdfs:comment "Property MarkingName (xs:string) — common name of the marking (preferably IRDI from IEC CDD or ECLASS). semanticId: 0112/2///61987#ABA231#009. Mandatory within MarkingSMC." ;
    rdfs:subClassOf <https://admin-shell.io/aas/3/1/Property> ;
    ns1:semanticId "0112/2///61987#ABA231#009" .

ns1:OrderCodeProperty a owl:Class ;
    rdfs:comment "Property OrderCodeOfManufacturer (xs:string) — unique order identifier. semanticId: 0112/2///61987#ABA950#008. Mandatory (changed from optional in v2)." ;
    rdfs:subClassOf <https://admin-shell.io/aas/3/1/Property> ;
    ns1:semanticId "0112/2///61987#ABA950#008",
        "https://admin-shell.io/zvei/nameplate/1/0/Nameplate/OrderCodeOfManufacturer" .

ns1:ParameterUnitProperty a owl:Class ;
    rdfs:comment "Property Unit (xs:string, optional) -- the unit of the value (added 2 Oct 2026)." ;
    rdfs:subClassOf <https://admin-shell.io/aas/3/1/Property> ;
    ns1:idShort "Unit" ;
    ns1:parentClass ns1:ParameterEntrySMC .

ns1:ParameterValueProperty a owl:Class ;
    rdfs:comment "Property Value (optional) -- the parameter's value as deployed; its valueType is the parameter's type (added 2 Oct 2026 for the registration service)." ;
    rdfs:subClassOf <https://admin-shell.io/aas/3/1/Property> ;
    ns1:idShort "Value" ;
    ns1:parentClass ns1:ParameterEntrySMC .

ns1:SchemeProperty a owl:Class ;
    rdfs:comment "Property scheme (xs:string) — security scheme type identifier (nosec, basic, apikey, bearer, psk, digest, oauth2, combo, auto)." ;
    rdfs:subClassOf <https://admin-shell.io/aas/3/1/Property> ;
    ns1:idShort "scheme" ;
    ns1:parentClass ns1:SecuritySchemeSMC ;
    ns1:semanticId "https://www.w3.org/2019/wot/security#SecurityScheme" .

ns1:SecuritySML a owl:Class ;
    rdfs:comment "SML security — list of active security scheme names (xs:string) referencing securityDefinitions." ;
    rdfs:subClassOf <https://admin-shell.io/aas/3/1/SubmodelElementList> ;
    ns1:idShort "security" ;
    ns1:parentClass ns1:EndpointMetadataSMC ;
    ns1:semanticId "https://www.w3.org/2019/wot/td#hasSecurityConfiguration" .

ns1:SinkIdProperty a owl:Class ;
    rdfs:comment "Property SinkId (xs:string) — identifier used by the transformation to address this sink." ;
    rdfs:subClassOf <https://admin-shell.io/aas/3/1/Property> ;
    ns1:semanticId "https://admin-shell.io/idta/AssetInterfacesMappingConfiguration/2/0/MappingConfiguration/Sink/SinkId" .

ns1:SinkRef a owl:Class ;
    rdfs:comment "ReferenceElement Sink -- points at the submodel element receiving the mapped value." ;
    rdfs:subClassOf <https://admin-shell.io/aas/3/1/ReferenceElement> ;
    ns1:semanticId "https://admin-shell.io/idta/AssetInterfacesMappingConfiguration/2/0/MappingConfiguration/Sink/Sink" .

ns1:SinksSML a owl:Class ;
    rdfs:comment "SML Sinks — the submodel elements this configuration writes to." ;
    rdfs:subClassOf <https://admin-shell.io/aas/3/1/SubmodelElementList> ;
    ns1:semanticId "https://admin-shell.io/idta/AssetInterfacesMappingConfiguration/2/0/MappingConfiguration/Sinks" .

ns1:SkillInterfaceReferenceRef a owl:Class ;
    rdfs:comment "ReferenceElement InterfaceReference — points directly at the specific AID action idShort (arso:InterfaceSMC/InteractionMetadata/actions/{action}) this skill invokes. Cross-submodel target validated via SPARQL SHACL, not OWL restriction (arso:SkillInterfaceRefActionShape / arso:SkillInterfaceRefTargetShape in arso-rules.shacl.ttl)." ;
    rdfs:subClassOf <https://admin-shell.io/aas/3/1/ReferenceElement> ;
    ns1:idShort "InterfaceReference" ;
    ns1:parentClass ns1:SkillSMC .

ns1:SkillOperationElement a owl:Class ;
    rdfs:comment "Operation {skill_name} — the invocable Operation of a skill entry. Applied unconditionally to every direct child of a SkillSMC with AAS modelType Operation (no idShort — its idShort matches the skill name). Its semanticId must use the lab's URI namespace (enforced via SHACL sh:pattern)." ;
    rdfs:subClassOf <https://admin-shell.io/aas/3/1/Operation> ;
    ns1:parentClass ns1:SkillSMC .

ns1:SkillStateMachineProperty a owl:Class ;
    rdfs:comment "Property StateMachine (xs:string) — present only on asynchronous skills. Polled by clients for intermediate state (IDLE, RUNNING, SUCCESS, FAILURE) during execution." ;
    rdfs:subClassOf <https://admin-shell.io/aas/3/1/Property> ;
    ns1:idShort "StateMachine" ;
    ns1:parentClass ns1:SkillSMC .

ns1:SkillStateReferenceRef a owl:Class ;
    rdfs:comment "ReferenceElement StateReference — the AID property that publishes this skill's state (the synchronous alternative to StateMachine)." ;
    rdfs:subClassOf <https://admin-shell.io/aas/3/1/ReferenceElement> ;
    ns1:idShort "StateReference" ;
    ns1:parentClass ns1:SkillSMC .

ns1:SourceIdProperty a owl:Class ;
    rdfs:comment "Property SourceId (xs:string) — identifier used by the transformation to address this source." ;
    rdfs:subClassOf <https://admin-shell.io/aas/3/1/Property> ;
    ns1:semanticId "https://admin-shell.io/idta/AssetInterfacesMappingConfiguration/2/0/MappingConfiguration/Source/SourceId" .

ns1:SourceRef a owl:Class ;
    rdfs:comment "ReferenceElement Source -- points at an AID property under .../InteractionMetadata/properties/{key}." ;
    rdfs:subClassOf <https://admin-shell.io/aas/3/1/ReferenceElement> ;
    ns1:semanticId "https://admin-shell.io/idta/AssetInterfacesMappingConfiguration/2/0/MappingConfiguration/Source/Source" .

ns1:SourcesSML a owl:Class ;
    rdfs:comment "SML Sources — the AID elements this configuration reads from." ;
    rdfs:subClassOf <https://admin-shell.io/aas/3/1/SubmodelElementList> ;
    ns1:semanticId "https://admin-shell.io/idta/AssetInterfacesMappingConfiguration/2/0/MappingConfiguration/Sources" .

ns1:TechnicalImageFile a owl:Class ;
    rdfs:comment "File ImageFile — pictorial representation of the product." ;
    rdfs:subClassOf <https://admin-shell.io/aas/3/1/File> ;
    ns1:semanticId "0173-1#02-ABK291#002" .

ns1:TechnicalManufacturerArticleNumberProperty a owl:Class ;
    rdfs:comment "Property ManufacturerArticleNumber (xs:string) — unique product identifier of the manufacturer." ;
    rdfs:subClassOf <https://admin-shell.io/aas/3/1/Property> ;
    ns1:semanticId "0173-1#02-AAO676#005" .

ns1:TechnicalManufacturerNameMLP a owl:Class ;
    rdfs:comment "MLP ManufacturerName — legally valid designation of the manufacturer." ;
    rdfs:subClassOf <https://admin-shell.io/aas/3/1/MultiLanguageProperty> ;
    ns1:semanticId "0173-1#02-AAO677#004" .

ns1:TechnicalManufacturerOrderCodeProperty a owl:Class ;
    rdfs:comment "Property ManufacturerOrderCode (xs:string) — unique code used for ordering." ;
    rdfs:subClassOf <https://admin-shell.io/aas/3/1/Property> ;
    ns1:semanticId "0173-1#02-AAO227#004" .

ns1:TechnicalManufacturerProductDesignationMLP a owl:Class ;
    rdfs:comment "MLP ManufacturerProductDesignation — short description of the product." ;
    rdfs:subClassOf <https://admin-shell.io/aas/3/1/MultiLanguageProperty> ;
    ns1:semanticId "0173-1#02-AAW338#003" .

ns1:TechnicalTextStatementMLP a owl:Class ;
    rdfs:comment "MLP TextStatement — note or explanation about the product." ;
    rdfs:subClassOf <https://admin-shell.io/aas/3/1/MultiLanguageProperty> ;
    ns1:semanticId "0173-1#02-ABK134#002" .

ns1:TechnicalValidDateProperty a owl:Class ;
    rdfs:comment "Property ValidDate (xs:date) — validity date for the further information entry." ;
    rdfs:subClassOf <https://admin-shell.io/aas/3/1/Property> ;
    ns1:semanticId "0173-1#02-ABL775#001" .

ns1:TransitionConstrainedByRel a owl:Class ;
    rdfs:comment "RelationshipElement TransitionConstrainedBy — first: constrained Capability; second: constraining Capability from another CapabilityContainer." ;
    rdfs:subClassOf <https://admin-shell.io/aas/3/1/RelationshipElement> ;
    ns1:semanticId "https://admin-shell.io/idta/CapabilityDescription/TransitionConstrainedBy/1/0" .

ns1:URIOfTheProductProperty a owl:Class ;
    rdfs:comment "Property URIOfTheProduct (xs:anyURI) — unique global identification of the product instance. semanticId: 0112/2///61987#ABN590#002. Mandatory (cardinality 1) in v3.0." ;
    rdfs:subClassOf <https://admin-shell.io/aas/3/1/Property> ;
    ns1:semanticId "0112/2///61987#ABN590#002" .

<http://www.w3id.org/hsu-aut/css#provides> a owl:ObjectProperty ;
    rdfs:domain <http://www.w3id.org/hsu-aut/css#Resource> .

<https://admin-shell.io/aas/3/1/DataSpecificationContent> a owl:Class ;
    rdfs:label "Data Specification Content"^^xsd:string ;
    rdfs:comment "Data specification content is part of a data specification template and defines which additional attributes shall be added to the element instance that references the data specification template and meta information about the template itself."@en .

<https://admin-shell.io/aas/3/1/DataTypeDefXsd/Decimal> a <https://admin-shell.io/aas/3/1/DataTypeDefXsd> ;
    rdfs:label "Decimal"^^xsd:string .

<https://admin-shell.io/aas/3/1/Direction> a owl:Class ;
    rdfs:label "Direction"^^xsd:string ;
    rdfs:comment "Direction"@en ;
    owl:oneOf _:n9af89c576b5341e79f601510185f8454b71 .

<https://admin-shell.io/aas/3/1/EntityType> a owl:Class ;
    rdfs:label "Entity Type"^^xsd:string ;
    rdfs:comment "Enumeration for denoting whether an entity is a self-managed entity or a co-managed entity."@en ;
    owl:oneOf _:n9af89c576b5341e79f601510185f8454b73 .

<https://admin-shell.io/aas/3/1/EntityType/SelfManagedEntity> a <https://admin-shell.io/aas/3/1/EntityType> ;
    rdfs:label "Self Managed Entity"^^xsd:string ;
    rdfs:comment "Self-Managed Entities have their own AAS but can be part of the bill of material of a composite self-managed entity."@en .

<https://admin-shell.io/aas/3/1/ModellingKind> a owl:Class ;
    rdfs:label "Modelling Kind"^^xsd:string ;
    rdfs:comment "Enumeration for denoting whether an element is a template or an instance."@en ;
    owl:oneOf _:n9af89c576b5341e79f601510185f8454b99 .

<https://admin-shell.io/aas/3/1/ReferenceTypes> a owl:Class ;
    rdfs:label "Reference Types"^^xsd:string ;

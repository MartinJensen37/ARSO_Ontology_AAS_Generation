@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix aas:   <https://admin-shell.io/aas/3/1/> .
@prefix arso:  <https://w3id.org/2025/arso#> .

# Manual SHACL rules for constraints the owl2shacl ruleset cannot produce.
#################################################################
# CONDITIONAL SUBMODEL DEPENDENCIES
#
# A -> B expressed as the standard  not-A or B  idiom. These work without a
# reasoner because arso:hasXSubmodel is materialised as a direct edge by
# Transformation/AAS_to_RDF/aas_to_rdf.py.
#################################################################

# These two hold for a module (arso:ResourceAAS). A component (arso:ComponentAAS, v0.7) has skills
# and neither an interface nor capabilities of its own: the module it is built into has them.

arso:SkillsImplyAidShape
  a sh:NodeShape ;
  rdfs:label "A Skills submodel requires an AID submodel" ;
  sh:targetClass arso:ResourceAAS ;
  sh:or (
    [ sh:path arso:hasSkillsSubmodel ; sh:maxCount 0 ]
    [ sh:path arso:hasAIDSubmodel    ; sh:minCount 1 ]
  ) ;
  sh:message "This AAS has a Skills submodel but no AID submodel. Skills are invoked through AID interfaces, so an AID submodel is required." .

arso:OperationalDataImpliesAidShape
  a sh:NodeShape ;
  rdfs:label "An OperationalData submodel requires an AID submodel" ;
  sh:targetClass aas:AssetAdministrationShell ;
  sh:or (
    [ sh:path arso:hasOperationalDataSubmodel ; sh:maxCount 0 ]
    [ sh:path arso:hasAIDSubmodel             ; sh:minCount 1 ]
  ) ;
  sh:message "This AAS has an OperationalData submodel but no AID submodel. OperationalData variables bind to AID properties, so an AID submodel is required." .

arso:ParametersImplyAidShape
  a sh:NodeShape ;
  rdfs:label "A Parameters submodel requires an AID submodel" ;
  sh:targetClass aas:AssetAdministrationShell ;
  sh:or (
    [ sh:path arso:hasParametersSubmodel ; sh:maxCount 0 ]
    [ sh:path arso:hasAIDSubmodel        ; sh:minCount 1 ]
  ) ;
  sh:message "This AAS has a Parameters submodel but no AID submodel. Parameters bind to AID properties, so an AID submodel is required." .

arso:AIMCImpliesAidShape
  a sh:NodeShape ;
  rdfs:label "An AIMC submodel requires an AID submodel" ;
  sh:targetClass aas:AssetAdministrationShell ;
  sh:or (
    [ sh:path arso:hasAIMCSubmodel ; sh:maxCount 0 ]
    [ sh:path arso:hasAIDSubmodel  ; sh:minCount 1 ]
  ) ;
  sh:message "This AAS has an AIMC submodel but no AID submodel. AIMC maps AID properties, so an AID submodel is required." .

arso:CapabilitiesImplySkillsShape
  a sh:NodeShape ;
  rdfs:label "A Capabilities submodel requires a Skills submodel" ;
  sh:targetClass aas:AssetAdministrationShell ;
  sh:or (
    [ sh:path arso:hasCapabilitiesSubmodel ; sh:maxCount 0 ]
    [ sh:path arso:hasSkillsSubmodel       ; sh:minCount 1 ]
  ) ;
  sh:message "This AAS has a Capabilities submodel but no Skills submodel. A Capability is realized by Skills, so a Skills submodel is required." .

arso:SkillsImplyCapabilitiesShape
  a sh:NodeShape ;
  rdfs:label "A Skills submodel requires a Capabilities submodel" ;
  sh:targetClass arso:ResourceAAS ;
  sh:or (
    [ sh:path arso:hasSkillsSubmodel       ; sh:maxCount 0 ]
    [ sh:path arso:hasCapabilitiesSubmodel ; sh:minCount 1 ]
  ) ;
  sh:message "This AAS has a Skills submodel but no Capabilities submodel. Every Skill must be realized by a Capability, so a Capabilities submodel is required." .


#################################################################
# VALUE ENUMERATIONS AND DISJUNCTIONS
#################################################################

# owl:oneOf ("Full" "OneDown" "OneUp") on arso:ArcheTypeProperty is not
# translated by owl2shacl, so the enum is enforced here instead.
arso:ArcheTypeValueShape
  a sh:NodeShape ;
  rdfs:label "ArcheType must be one of Full, OneDown, OneUp" ;
  sh:targetClass arso:ArcheTypeProperty ;
  sh:property [
    sh:path <https://admin-shell.io/aas/3/1/Property/value> ;
    # Explicitly ^^xsd:string: the RDF projection emits Property/value as an
    # xsd:string-typed literal, and rdflib does not treat a plain Turtle
    # literal as equal to an xsd:string-typed one, so a bare "Full" here
    # matches nothing and the shape fires on valid values.
    sh:in ( "Full"^^xsd:string "OneDown"^^xsd:string "OneUp"^^xsd:string ) ;
    sh:message "HierarchicalStructures ArcheType must be exactly 'Full', 'OneDown' or 'OneUp'." ;
  ] .

# A Forms SMC must carry an address, but which property that is depends on the
# protocol: href (MQTT/HTTP), opc_node_id (OPC-UA), modv_address (Modbus).
# A disjunction, so not expressible as an OWL restriction the ruleset can use.
arso:FormsAddressingShape
  a sh:NodeShape ;
  rdfs:label "A Forms SMC must carry a protocol address" ;
  sh:targetClass arso:FormsSMC ;
  sh:or (
    [ sh:path <https://admin-shell.io/aas/3/1/SubmodelElementCollection/value> ;
      sh:qualifiedValueShape [ sh:class arso:HrefProperty ]        ; sh:qualifiedMinCount 1 ]
    [ sh:path <https://admin-shell.io/aas/3/1/SubmodelElementCollection/value> ;
      sh:qualifiedValueShape [ sh:class arso:UavNodeIdProperty ]   ; sh:qualifiedMinCount 1 ]
    [ sh:path <https://admin-shell.io/aas/3/1/SubmodelElementCollection/value> ;
      sh:qualifiedValueShape [ sh:class arso:ModvAddressProperty ] ; sh:qualifiedMinCount 1 ]
  ) ;
  sh:message "This Forms SMC has no protocol address: expected href (MQTT/HTTP), opc_node_id (OPC-UA) or modv_address (Modbus)." .


#################################################################
# HOW A SKILL IS CALLED (ARSO 0.7)
#################################################################

# A skill is described by its commands (Start, Stop, Abort, Reset), or in the short form by one
# Operation and one InterfaceReference of its own. A disjunction, so not an OWL restriction.

arso:SkillCallableShape
  a sh:NodeShape ;
  rdfs:label "A Skill has its commands, or an Operation and an InterfaceReference of its own" ;
  sh:targetClass arso:SkillSMC ;
  sh:or (
    [ sh:path <https://admin-shell.io/aas/3/1/SubmodelElementCollection/value> ;
      sh:qualifiedValueShape [ sh:class arso:SkillCommandSMC ] ; sh:qualifiedMinCount 1 ]
    [ sh:and (
        [ sh:path <https://admin-shell.io/aas/3/1/SubmodelElementCollection/value> ;
          sh:qualifiedValueShape [ sh:class arso:SkillOperationElement ] ; sh:qualifiedMinCount 1 ]
        [ sh:path <https://admin-shell.io/aas/3/1/SubmodelElementCollection/value> ;
          sh:qualifiedValueShape [ sh:class arso:SkillInterfaceReferenceRef ] ; sh:qualifiedMinCount 1 ] ) ]
  ) ;
  sh:message "This Skill cannot be called: it has neither a command (Start, Stop, Abort, Reset) nor an Operation with an InterfaceReference of its own." .

# A command is called through its Operation.

arso:CommandOperationShape
  a sh:NodeShape ;
  rdfs:label "A command of a skill or of the resource has exactly one Operation" ;
  sh:targetClass arso:SkillCommandSMC , arso:ModuleCommandSMC ;
  sh:property [
    sh:path <https://admin-shell.io/aas/3/1/SubmodelElementCollection/value> ;
    sh:qualifiedValueShape [ sh:class arso:SkillOperationElement ] ;
    sh:qualifiedMinCount 1 ; sh:qualifiedMaxCount 1 ;
    sh:message "A command needs exactly one Operation (named like the command)." ] .


#################################################################
# CROSS-SUBMODEL REFERENCE RESOLUTION (SPARQL -- see category 1 above)
#################################################################

# Skill interface references must resolve to an InterfaceSMC in the same AAS.
# ARSO 0.7: the reference is also carried by a command of a skill. A component's AAS has no
# interface description of its own (the module it is built into carries its skills out, and the
# reference leads into that module's AAS), so only a shell that has one is judged here.

arso:SkillInterfaceRefTargetShape
  a sh:NodeShape ;
  rdfs:label "SkillInterfaceRef must target an InterfaceSMC in the same AAS's AID submodel" ;
  sh:targetClass arso:SkillInterfaceReferenceRef ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "arso:SkillInterfaceRef points at no AID Interface in the same AAS, or AID submodel is missing." ;
    sh:select """
      SELECT $this WHERE {
        ?shell  rdf:type                                                     <https://admin-shell.io/aas/3/1/AssetAdministrationShell> ;
                <https://w3id.org/2025/arso#hasSkillsSubmodel>               ?skillsSm ;
                <https://w3id.org/2025/arso#hasAIDSubmodel>                  ?ownAid .
        ?skillsSm
                (<https://admin-shell.io/aas/3/1/Submodel/submodelElements>|<https://admin-shell.io/aas/3/1/SubmodelElementCollection/value>)+
                $this .

        # Violates only if NONE of $this's reference keys resolve to an AID Interface --
        # a Reference/keys set is unordered in RDF (no list index survives the JSON->RDF
        # projection), so we can't single out "the last key" and must test all of them
        # existentially, exactly like the working SkillInterfaceRefActionShape below.
        FILTER NOT EXISTS {
          $this <https://admin-shell.io/aas/3/1/ReferenceElement/value> ?ref .
          ?ref  <https://admin-shell.io/aas/3/1/Reference/keys>          ?key .
          ?key  <https://admin-shell.io/aas/3/1/Key/value>               ?targetIdShort .

          ?shell  <https://w3id.org/2025/arso#hasAIDSubmodel>          ?aidSm .
          ?aidSm  (<https://admin-shell.io/aas/3/1/Submodel/submodelElements>|<https://admin-shell.io/aas/3/1/SubmodelElementCollection/value>)+
                  ?iface .
          ?iface  rdf:type                                              <https://w3id.org/2025/arso#InterfaceSMC> ;
                  <https://admin-shell.io/aas/3/1/Referable/idShort>    ?targetIdShort .
        }
      }
    """ ;
  ] .

# Capability realizedBy targets must resolve to a Skill in the same AAS.
# CapabilityRealizedByRel is a RelationshipElement (first/second), not a ReferenceElement --
# the target lives on RelationshipElement/second, not ReferenceElement/value.

arso:RealizedByRefTargetShape
  a sh:NodeShape ;
  rdfs:label "CapabilityRealizedBy.second must reference an existing Skill element in the same AAS's Skills submodel" ;
  sh:targetClass arso:CapabilityRealizedByRel ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "A Capability realizedBy relationship's 'second' reference points at no Skill in the same AAS's Skills submodel." ;
    sh:select """
      SELECT $this WHERE {
        ?shell  rdf:type                                                     <https://admin-shell.io/aas/3/1/AssetAdministrationShell> ;
                <https://w3id.org/2025/arso#hasCapabilitiesSubmodel>         ?capsSm .
        ?capsSm
                (<https://admin-shell.io/aas/3/1/Submodel/submodelElements>|<https://admin-shell.io/aas/3/1/SubmodelElementCollection/value>|<https://admin-shell.io/aas/3/1/SubmodelElementList/value>)+
                $this .

        # Same existential-over-all-keys reasoning as SkillInterfaceRefTargetShape above.
        FILTER NOT EXISTS {
          $this <https://admin-shell.io/aas/3/1/RelationshipElement/second> ?ref .
          ?ref  <https://admin-shell.io/aas/3/1/Reference/keys>             ?key .
          ?key  <https://admin-shell.io/aas/3/1/Key/value>                  ?targetIdShort .

          ?shell  <https://w3id.org/2025/arso#hasSkillsSubmodel>       ?skillsSm .
          ?skillsSm
                  (<https://admin-shell.io/aas/3/1/Submodel/submodelElements>|<https://admin-shell.io/aas/3/1/SubmodelElementCollection/value>)+
                  ?skill .
          ?skill  rdf:type                                              <https://admin-shell.io/aas/3/1/SubmodelElementCollection> ;
                  <https://admin-shell.io/aas/3/1/Referable/idShort>    ?targetIdShort .
        }
      }
    """ ;
  ] .

arso:SkillMustBeRealizedByCapabilityShape
  a sh:NodeShape ;
  rdfs:label "Every Skill must be realized by a Capability, itself or as a step of a composite Skill" ;
  sh:targetClass arso:SkillSMC ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "This Skill is not referenced by any Capability's realizedBy, and no Skill that is uses it. Every Skill must be realized by at least one Capability, itself or as a step of a composite Skill (several Skills may share one Capability). A primitive Skill (Kind Primitive, or the semanticId .../skill/Primitive), Occupy and Release are exempt." ;
    sh:select """
      SELECT $this WHERE {
        ?shell  rdf:type                                              <https://admin-shell.io/aas/3/1/AssetAdministrationShell> ;
                <https://w3id.org/2025/arso#hasSkillsSubmodel>         ?skillsSm .
        ?skillsSm
                (<https://admin-shell.io/aas/3/1/Submodel/submodelElements>|<https://admin-shell.io/aas/3/1/SubmodelElementCollection/value>)+
                $this .
        $this   <https://admin-shell.io/aas/3/1/Referable/idShort>     ?skillIdShort .

        # Occupy and Release say who may control the resource. They are access
        # control, not production, and realize no capability. Open: whether
        # they stay in the list of skills at all (6 Oct 2026).
        OPTIONAL {
          ?meaning <https://admin-shell.io/aas/3/1/Referable/idShort>     "SemanticId"^^xsd:string .
          $this    <https://admin-shell.io/aas/3/1/SubmodelElementCollection/value> ?meaning .
          ?meaning <https://admin-shell.io/aas/3/1/Property/value>        ?skillMeaning .
        }
        FILTER (!BOUND(?skillMeaning) || str(?skillMeaning) NOT IN (
                  "https://smartproductionlab.aau.dk/skills/Occupy",
                  "https://smartproductionlab.aau.dk/skills/Release"))

        # A primitive is a building block: composite skills are made of
        # primitives, and reconfiguration makes new ones of them. It needs no
        # capability of its own, used by a composite or not. A skill that does
        # not say its Kind is held to the rule.
        OPTIONAL {
          ?kind    <https://admin-shell.io/aas/3/1/Referable/idShort>     "Kind"^^xsd:string .
          $this    <https://admin-shell.io/aas/3/1/SubmodelElementCollection/value> ?kind .
          ?kind    <https://admin-shell.io/aas/3/1/Property/value>        ?skillKind .
        }
        FILTER (!BOUND(?skillKind) || str(?skillKind) != "Primitive")

        # Since ARSO 0.7 the kind is the semanticId of the skill element.
        OPTIONAL {
          $this    <https://admin-shell.io/aas/3/1/HasSemantics/semanticId>  ?kindRef .
          ?kindRef <https://admin-shell.io/aas/3/1/Reference/keys>           ?kindKey .
          ?kindKey <https://admin-shell.io/aas/3/1/Key/value>                ?skillClass .
        }
        FILTER (!BOUND(?skillClass) || str(?skillClass) != "https://smartproductionlab.aau.dk/skill/Primitive")

        FILTER NOT EXISTS {
          ?shell  <https://w3id.org/2025/arso#hasCapabilitiesSubmodel> ?capsSm .
          ?capsSm
                  (<https://admin-shell.io/aas/3/1/Submodel/submodelElements>|<https://admin-shell.io/aas/3/1/SubmodelElementCollection/value>|<https://admin-shell.io/aas/3/1/SubmodelElementList/value>)+
                  ?relBy .
          ?relBy  <https://admin-shell.io/aas/3/1/RelationshipElement/second> ?ref .
          ?ref    <https://admin-shell.io/aas/3/1/Reference/keys>            ?key .
          ?key    <https://admin-shell.io/aas/3/1/Key/value>                 ?skillIdShort .
        }

        # Or a step of a composite Skill that is: arso:usesSkill is the resolved
        # Uses entry, and a composite may itself be a step of another.
        FILTER NOT EXISTS {
          ?composite <https://w3id.org/2025/arso#usesSkill>+ $this .
          FILTER EXISTS {
            ?composite <https://admin-shell.io/aas/3/1/Referable/idShort>   ?compositeIdShort .
            ?shell  <https://w3id.org/2025/arso#hasCapabilitiesSubmodel> ?capsSm2 .
            ?capsSm2
                    (<https://admin-shell.io/aas/3/1/Submodel/submodelElements>|<https://admin-shell.io/aas/3/1/SubmodelElementCollection/value>|<https://admin-shell.io/aas/3/1/SubmodelElementList/value>)+
                    ?relBy2 .
            ?relBy2 <https://admin-shell.io/aas/3/1/RelationshipElement/second> ?ref2 .
            ?ref2   <https://admin-shell.io/aas/3/1/Reference/keys>            ?key2 .
            ?key2   <https://admin-shell.io/aas/3/1/Key/value>                 ?compositeIdShort .
          }
        }
      }
    """ ;
  ] .

# Skill InterfaceReference targets must name an existing AID action.

arso:SkillInterfaceRefActionShape
  a sh:NodeShape ;
  rdfs:label "Skill InterfaceReference must resolve to an existing AID action idShort" ;
  sh:targetClass arso:SkillsSubmodel ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "A Skill InterfaceReference contains no key value that matches any action idShort in AID/…/InteractionMetadata/actions. Check that the referenced action name exists in the AID." ;
    sh:select """
      SELECT $this WHERE {
        $this (<https://admin-shell.io/aas/3/1/Submodel/submodelElements>
               | <https://admin-shell.io/aas/3/1/SubmodelElementCollection/value>
               | <https://admin-shell.io/aas/3/1/SubmodelElementList/value>)+ ?refElem .
        ?refElem rdf:type <https://admin-shell.io/aas/3/1/ReferenceElement> ;
                 <https://admin-shell.io/aas/3/1/Referable/idShort> "InterfaceReference"^^xsd:string .

        ?shell <https://w3id.org/2025/arso#hasSkillsSubmodel> $this ;
               <https://w3id.org/2025/arso#hasAIDSubmodel>    ?ownAid .

        FILTER NOT EXISTS {
          ?refElem <https://admin-shell.io/aas/3/1/ReferenceElement/value> ?ref .
          ?ref     <https://admin-shell.io/aas/3/1/Reference/keys>         ?key .
          ?key     <https://admin-shell.io/aas/3/1/Key/value>              ?keyVal .

          ?shell <https://w3id.org/2025/arso#hasAIDSubmodel> ?aidSm .
          ?aidSm  (<https://admin-shell.io/aas/3/1/Submodel/submodelElements>
                   | <https://admin-shell.io/aas/3/1/SubmodelElementCollection/value>)+ ?actionsContainer .
          ?actionsContainer <https://admin-shell.io/aas/3/1/Referable/idShort> "actions"^^xsd:string .
          ?actionsContainer <https://admin-shell.io/aas/3/1/SubmodelElementCollection/value> ?actionSmc .
          ?actionSmc <https://admin-shell.io/aas/3/1/Referable/idShort> ?keyVal .
        }
      }
    """ ;
  ] .

# No "InteractionMetadata must have >=1 action" rule: property-only interfaces
# are valid per IDTA 02017-1 and WoT TD. Interfaces with neither actions nor
# properties are caught by the empty-interface check below.

# EntryNode should not be empty when HierarchicalStructures exists.

arso:HierarchicalStructuresEntryNodeNonEmptyShape
  a sh:NodeShape ;
  rdfs:label "EntryNode in HierarchicalStructures should declare BoM content" ;
  sh:targetClass arso:EntryNodeEntity ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:severity sh:Warning ;
    sh:message "BomEntity has no Entity/statements (HasPart, IsPartOf, SameAs, BulkCount, child Entity)" ;
    sh:select """
      SELECT $this WHERE {
        FILTER NOT EXISTS {
          $this <https://admin-shell.io/aas/3/1/Entity/statements> ?stmt .
        }
      }
    """ ;
  ] .

# Lab URI-namespace convention for Skill/Capability/OperationalData semanticIds.
# Previously enforced only client-side (ui/src/components/shared/SemanticIdInput.tsx);
# moved here so the backend is the single source of truth and any client can rely on it.

arso:SkillOperationSemanticIdPatternShape
  a sh:NodeShape ;
  rdfs:label "Skill Operation semanticId must use the lab's URI namespace" ;
  sh:targetClass arso:SkillOperationElement ;
  sh:property [
    sh:path ( <https://admin-shell.io/aas/3/1/HasSemantics/semanticId>
              <https://admin-shell.io/aas/3/1/Reference/keys>
              <https://admin-shell.io/aas/3/1/Key/value> ) ;
    sh:pattern "^https?://(smartproductionlab\\.aau\\.dk|w3id\\.org/2026/apex)/" ;
    sh:message "Skill semanticId must be a URI under https://smartproductionlab.aau.dk/ (lab convention), or a command of the resource's state machine under https://w3id.org/2026/apex/." ;
  ] .

# A Capability says what it means with a URI of the lab's namespace. IDTA 02020
# puts the template's own id on the element and the meaning beside it as a
# supplemental id; this project's builder writes the meaning as the element's
# id. Both are accepted.

arso:CapabilitySemanticIdPatternShape
  a sh:NodeShape ;
  rdfs:label "Capability meaning must use the lab's URI namespace" ;
  sh:targetClass arso:CapabilityElement ;
  sh:or (
    [ sh:property [
        sh:path ( <https://admin-shell.io/aas/3/1/HasSemantics/semanticId>
                  <https://admin-shell.io/aas/3/1/Reference/keys>
                  <https://admin-shell.io/aas/3/1/Key/value> ) ;
        sh:pattern "^https://admin-shell\\.io/idta/CapabilityDescription/Capability/1/0$" ;
      ] ;
      sh:property [
        sh:path ( <https://admin-shell.io/aas/3/1/HasSemantics/supplementalSemanticIds>
                  <https://admin-shell.io/aas/3/1/Reference/keys>
                  <https://admin-shell.io/aas/3/1/Key/value> ) ;
        sh:qualifiedValueShape [ sh:pattern "^https?://smartproductionlab\\.aau\\.dk/" ] ;
        sh:qualifiedMinCount 1 ;
      ] ;
    ]
    [ sh:property [
        sh:path ( <https://admin-shell.io/aas/3/1/HasSemantics/semanticId>
                  <https://admin-shell.io/aas/3/1/Reference/keys>
                  <https://admin-shell.io/aas/3/1/Key/value> ) ;
        sh:pattern "^https?://smartproductionlab\\.aau\\.dk/" ;
      ] ;
    ]
  ) ;
  sh:message "A Capability needs a URI under https://smartproductionlab.aau.dk/ (lab convention): as a supplemental semantic id beside the id of IDTA 02020, or as its semanticId." .

arso:OperationalDataVariableSemanticIdPatternShape
  a sh:NodeShape ;
  rdfs:label "OperationalData variable semanticId must use the lab's URI namespace" ;
  sh:targetClass arso:OperationalDataVariableSMC ;
  sh:property [
    sh:path ( <https://admin-shell.io/aas/3/1/HasSemantics/semanticId>
              <https://admin-shell.io/aas/3/1/Reference/keys>
              <https://admin-shell.io/aas/3/1/Key/value> ) ;
    sh:pattern "^https?://smartproductionlab\\.aau\\.dk/" ;
    sh:message "OperationalData variable semanticId must be a URI under https://smartproductionlab.aau.dk/ (lab convention)." ;
  ] .

arso:ParameterSemanticIdPatternShape
  a sh:NodeShape ;
  rdfs:label "Parameter entry semanticId must use the lab's URI namespace" ;
  sh:targetClass arso:ParameterEntrySMC ;
  sh:property [
    sh:path ( <https://admin-shell.io/aas/3/1/HasSemantics/semanticId>
              <https://admin-shell.io/aas/3/1/Reference/keys>
              <https://admin-shell.io/aas/3/1/Key/value> ) ;
    sh:pattern "^https?://smartproductionlab\\.aau\\.dk/" ;
    sh:message "Parameter entry semanticId must be a URI under https://smartproductionlab.aau.dk/ (lab convention)." ;
  ] .

# OperationalData / Parameters InterfaceReference targets must name an existing
# AID property -- both builders hardcode the "properties" path segment.

arso:OperationalDataInterfaceRefTargetShape
  a sh:NodeShape ;
  rdfs:label "OperationalData variable InterfaceReference must resolve to an existing AID property" ;
  sh:targetClass arso:OperationalDataInterfaceReferenceRef ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "An OperationalData variable's InterfaceReference points at no AID property in the same AAS, or the AID submodel is missing." ;
    sh:select """
      SELECT $this WHERE {
        ?shell  rdf:type                                                     <https://admin-shell.io/aas/3/1/AssetAdministrationShell> ;
                <https://w3id.org/2025/arso#hasOperationalDataSubmodel>      ?opSm .
        ?opSm
                (<https://admin-shell.io/aas/3/1/Submodel/submodelElements>|<https://admin-shell.io/aas/3/1/SubmodelElementCollection/value>)+
                $this .

        FILTER NOT EXISTS {
          $this <https://admin-shell.io/aas/3/1/ReferenceElement/value> ?ref .
          ?ref  <https://admin-shell.io/aas/3/1/Reference/keys>          ?key .
          ?key  <https://admin-shell.io/aas/3/1/Key/value>               ?targetIdShort .

          ?shell  <https://w3id.org/2025/arso#hasAIDSubmodel>          ?aidSm .
          ?aidSm  (<https://admin-shell.io/aas/3/1/Submodel/submodelElements>|<https://admin-shell.io/aas/3/1/SubmodelElementCollection/value>)+
                  ?propsContainer .
          ?propsContainer <https://admin-shell.io/aas/3/1/Referable/idShort> "properties"^^xsd:string .
          ?propsContainer <https://admin-shell.io/aas/3/1/SubmodelElementCollection/value> ?prop .
          ?prop   <https://admin-shell.io/aas/3/1/Referable/idShort>    ?targetIdShort .
        }
      }
    """ ;
  ] .

arso:ParameterInterfaceRefTargetShape
  a sh:NodeShape ;
  rdfs:label "Parameter InterfaceReference must resolve to an existing AID property" ;
  sh:targetClass arso:ParameterInterfaceReferenceRef ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "A Parameter's InterfaceReference points at no AID property in the same AAS, or the AID submodel is missing." ;
    sh:select """
      SELECT $this WHERE {
        ?shell  rdf:type                                                     <https://admin-shell.io/aas/3/1/AssetAdministrationShell> ;
                <https://w3id.org/2025/arso#hasParametersSubmodel>          ?paramsSm .
        ?paramsSm
                (<https://admin-shell.io/aas/3/1/Submodel/submodelElements>|<https://admin-shell.io/aas/3/1/SubmodelElementCollection/value>)+
                $this .

        FILTER NOT EXISTS {
          $this <https://admin-shell.io/aas/3/1/ReferenceElement/value> ?ref .
          ?ref  <https://admin-shell.io/aas/3/1/Reference/keys>          ?key .
          ?key  <https://admin-shell.io/aas/3/1/Key/value>               ?targetIdShort .

          ?shell  <https://w3id.org/2025/arso#hasAIDSubmodel>          ?aidSm .
          ?aidSm  (<https://admin-shell.io/aas/3/1/Submodel/submodelElements>|<https://admin-shell.io/aas/3/1/SubmodelElementCollection/value>)+
                  ?propsContainer .
          ?propsContainer <https://admin-shell.io/aas/3/1/Referable/idShort> "properties"^^xsd:string .
          ?propsContainer <https://admin-shell.io/aas/3/1/SubmodelElementCollection/value> ?prop .
          ?prop   <https://admin-shell.io/aas/3/1/Referable/idShort>    ?targetIdShort .
        }
      }
    """ ;
  ] .


#################################################################
# AIMC (IDTA 02027) REFERENCE RESOLUTION
#################################################################

# A MappingConfiguration's InterfaceReference must name an AID interface.

arso:AIMCInterfaceRefTargetShape
  a sh:NodeShape ;
  rdfs:label "AIMC InterfaceReference must resolve to an existing AID interface" ;
  sh:targetClass arso:AIMCInterfaceReferenceRef ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "An AIMC MappingConfiguration's InterfaceReference points at no AID interface in the same AAS, or the AID submodel is missing." ;
    sh:select """
      SELECT $this WHERE {
        ?shell  rdf:type                                                     <https://admin-shell.io/aas/3/1/AssetAdministrationShell> ;
                <https://w3id.org/2025/arso#hasAIMCSubmodel>                ?aimcSm .
        ?aimcSm
                (<https://admin-shell.io/aas/3/1/Submodel/submodelElements>|<https://admin-shell.io/aas/3/1/SubmodelElementCollection/value>|<https://admin-shell.io/aas/3/1/SubmodelElementList/value>)+
                $this .

        FILTER NOT EXISTS {
          $this <https://admin-shell.io/aas/3/1/ReferenceElement/value> ?ref .
          ?ref  <https://admin-shell.io/aas/3/1/Reference/keys>          ?key .
          ?key  <https://admin-shell.io/aas/3/1/Key/value>               ?targetIdShort .

          ?shell  <https://w3id.org/2025/arso#hasAIDSubmodel>          ?aidSm .
          ?aidSm  <https://admin-shell.io/aas/3/1/Submodel/submodelElements> ?iface .
          ?iface  <https://admin-shell.io/aas/3/1/Referable/idShort>    ?targetIdShort .
        }
      }
    """ ;
  ] .

# A Source must name an existing AID property, or an Operation of the Skills
# submodel whose mapping hands it to an AID action: the Sink of the same
# mapping names that action, and what holds the Operation (a skill, or the
# collection of the module's commands) references the action itself. The
# Sink of a property mapping is not checked: IDTA 02027 lets it target any
# submodel element.

arso:AIMCSourceRefTargetShape
  a sh:NodeShape ;
  rdfs:label "AIMC Source must resolve to an AID property, or to a skill Operation mapped onto its AID action" ;
  sh:targetClass arso:SourceRef ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "An AIMC Source reference points at no AID property in the same AAS, and at no Operation whose skill references the AID action the Sink names (or the AID submodel is missing)." ;
    sh:select """
      SELECT $this WHERE {
        ?shell  rdf:type                                                     <https://admin-shell.io/aas/3/1/AssetAdministrationShell> ;
                <https://w3id.org/2025/arso#hasAIMCSubmodel>                ?aimcSm .
        ?aimcSm
                (<https://admin-shell.io/aas/3/1/Submodel/submodelElements>|<https://admin-shell.io/aas/3/1/SubmodelElementCollection/value>|<https://admin-shell.io/aas/3/1/SubmodelElementList/value>)+
                $this .

        FILTER NOT EXISTS {
          $this <https://admin-shell.io/aas/3/1/ReferenceElement/value> ?ref .
          ?ref  <https://admin-shell.io/aas/3/1/Reference/keys>          ?key .
          ?key  <https://admin-shell.io/aas/3/1/Key/value>               ?targetIdShort .

          ?shell  <https://w3id.org/2025/arso#hasAIDSubmodel>          ?aidSm .
          ?aidSm  (<https://admin-shell.io/aas/3/1/Submodel/submodelElements>|<https://admin-shell.io/aas/3/1/SubmodelElementCollection/value>)+
                  ?propsContainer .
          ?propsContainer <https://admin-shell.io/aas/3/1/Referable/idShort> "properties"^^xsd:string .
          ?propsContainer <https://admin-shell.io/aas/3/1/SubmodelElementCollection/value> ?prop .
          ?prop   <https://admin-shell.io/aas/3/1/Referable/idShort>    ?targetIdShort .
        }

        # A Source in another AAS (the Operation of a component's skill, v0.7) cannot be
        # followed here: only a Source that names a submodel of this AAS is judged.
        FILTER EXISTS {
          $this   <https://admin-shell.io/aas/3/1/ReferenceElement/value> ?ownRef .
          ?ownRef <https://admin-shell.io/aas/3/1/Reference/keys>          ?ownKey .
          ?ownKey <https://admin-shell.io/aas/3/1/Key/value>               ?ownId .
          ?shell  <https://w3id.org/2025/arso#hasSubmodel>                 ?ownSm .
          ?ownSm  <https://admin-shell.io/aas/3/1/Identifiable/id>         ?ownId .
        }

        # Each step is an EXISTS of its own: rdflib orders the patterns of one group
        # without knowing what is bound, and one group over all of this takes minutes.
        FILTER NOT EXISTS {
          # The Operation the Source names ...
          ?opKey  <https://admin-shell.io/aas/3/1/Key/type>                <https://admin-shell.io/aas/3/1/KeyTypes/Operation> ;
                  <https://admin-shell.io/aas/3/1/Key/value>               ?opIdShort .
          ?opRef  <https://admin-shell.io/aas/3/1/Reference/keys>          ?opKey .
          $this   <https://admin-shell.io/aas/3/1/ReferenceElement/value>  ?opRef .
          FILTER EXISTS {
            # ... and what holds it: a skill, or the collection of the module's commands.
            ?op     rdf:type                                          <https://admin-shell.io/aas/3/1/Operation> ;
                    <https://admin-shell.io/aas/3/1/Referable/idShort>     ?opIdShort .
            ?holder <https://admin-shell.io/aas/3/1/SubmodelElementCollection/value> ?op .
            ?shell  (<https://w3id.org/2025/arso#hasSkillsSubmodel>|<https://w3id.org/2025/arso#hasModuleSubmodel>) ?skillsSm .
            ?skillsSm
                    (<https://admin-shell.io/aas/3/1/Submodel/submodelElements>|<https://admin-shell.io/aas/3/1/SubmodelElementCollection/value>|<https://admin-shell.io/aas/3/1/SubmodelElementList/value>)+
                    ?holder .
            FILTER EXISTS {
              # What the Sink of the same mapping names ...
              ?sinkRef rdf:type                                               <https://w3id.org/2025/arso#SinkRef> ;
                       <https://admin-shell.io/aas/3/1/ReferenceElement/value>      ?sinkTarget .
              ?sinkTarget <https://admin-shell.io/aas/3/1/Reference/keys>           ?sinkKey .
              ?sinkKey <https://admin-shell.io/aas/3/1/Key/value>                   ?actionIdShort .
              ?sink    <https://admin-shell.io/aas/3/1/SubmodelElementCollection/value> ?sinkRef .
              ?sinks   <https://admin-shell.io/aas/3/1/SubmodelElementList/value>   ?sink .
              ?mapping <https://admin-shell.io/aas/3/1/SubmodelElementCollection/value> ?sinks ;
                       <https://admin-shell.io/aas/3/1/SubmodelElementCollection/value> ?sources .
              ?sources <https://admin-shell.io/aas/3/1/SubmodelElementList/value>   ?source .
              ?source  <https://admin-shell.io/aas/3/1/SubmodelElementCollection/value> $this .
              FILTER EXISTS {
                # ... is an action of the AID ...
                ?actionsContainer <https://admin-shell.io/aas/3/1/Referable/idShort> "actions"^^xsd:string ;
                         <https://admin-shell.io/aas/3/1/SubmodelElementCollection/value> ?action .
                ?action  <https://admin-shell.io/aas/3/1/Referable/idShort>         ?actionIdShort .
                ?shell   <https://w3id.org/2025/arso#hasAIDSubmodel>         ?actionsSm .
                ?actionsSm (<https://admin-shell.io/aas/3/1/Submodel/submodelElements>|<https://admin-shell.io/aas/3/1/SubmodelElementCollection/value>)+
                         ?actionsContainer .
              }
              FILTER EXISTS {
                # ... that the holder of the Operation references itself.
                ?holder  (<https://admin-shell.io/aas/3/1/SubmodelElementCollection/value>|<https://admin-shell.io/aas/3/1/SubmodelElementList/value>)+
                         ?link .
                ?link    <https://admin-shell.io/aas/3/1/ReferenceElement/value>    ?linkTarget .
                ?linkTarget <https://admin-shell.io/aas/3/1/Reference/keys>         ?linkKey .
                ?linkKey <https://admin-shell.io/aas/3/1/Key/value>                 ?actionIdShort .
              }
            }
          }
        }
      }
    """ ;
  ] .

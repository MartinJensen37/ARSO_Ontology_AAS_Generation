@prefix arso: <https://w3id.org/2025/arso#> .
@prefix aas:  <https://admin-shell.io/aas/3/1/> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

#################################################################
# SMT STRUCTURE OVERVIEW
#################################################################
# Design note: ARSO flattens IDTA 02015 ControlComponentType. It keeps CCType's
# mandatory Interfaces/Skills/Errors containers but drops the per-skill
# Modes/Parameters/Disabled/Errors/Uses sub-structure and device-level Interfaces
# entries -- endpoint binding lives in the AID module, and each Skill links
# directly to the one AID action it invokes.
#
# Skills (Submodel)
#   ├─ Interfaces [SMC, 1] — always present, empty (CCType's mandatory
#   │    top-level container; ARSO does not populate device-level
#   │    interface entries here, see design note above)
#   ├─ Skills [SMC, 1]
#   │    └─ {skill_name} [SMC Skill, 0..*]
#   │         ├─ SemanticId [Property, xs:string, 1]
#   │         ├─ Operation {skill_name} [Operation, 1] — the invocable
#   │         │    operation; its input/output variables are derived from
#   │         │    the referenced AID action's schemas
#   │         ├─ InterfaceReference [ReferenceElement, 1] — points
#   │         │    directly at the specific AID action idShort
#   │         │    (arso:InterfaceSMC/InteractionMetadata/actions/{action})
#   │         │    this skill invokes. Cross-submodel target validated via
#   │         │    SPARQL SHACL, not OWL restriction (see
#   │         │    arso:SkillInterfaceRefActionShape /
#   │         │    arso:SkillInterfaceRefTargetShape in arso-rules.shacl.ttl)
#   │         ├─ StateMachine [Property, xs:string, 0..1] — present only
#   │         │    for asynchronous skills; polled for IDLE/RUNNING/
#   │         │    SUCCESS/FAILURE
#   │         │  --- optional, for skills that can be reconfigured (v0.5) ---
#   │         ├─ Kind [Property, xs:string, 0..1] — Primitive | Composite
#   │         ├─ Parameters [SMC, 0..1]
#   │         │    └─ {parameter} [Property, 0..*] — value = current value;
#   │         │         qualifiers Unit, Minimum, Maximum, Default
#   │         ├─ RealizesProperty [RelationshipElement, 0..*] — first: a
#   │         │    parameter of this skill; second: a capability property
#   │         │    (PropertyContainer) of the capability it realizes
#   │         │    (css:isRealizedBySkillParameter, read backwards)
#   │         ├─ Contract [SMC, 0..1] — primitives: Requires, Ensures | After,
#   │         │    Invariant, Timeout (css:Constraint: pre-, post-condition,
#   │         │    invariant)
#   │         ├─ Uses [SML of ReferenceElement, 0..1] — the skills a composite
#   │         │    uses (IDTA 02015 "Uses"): of this AAS or of a part in its
#   │         │    HierarchicalStructures, never of a sibling resource
#   │         ├─ Execute, Stop [SML of Step SMC, 0..1 each] — a composite's
#   │         │    sequences; Step: Skill [ReferenceElement, 1] and Bindings
#   │         │    [SMC of Property, 0..1] (constants bound to its parameters)
#   │         ├─ Occupies [SML of ReferenceElement, 0..1] — HierarchicalStructures
#   │         │    nodes (equipment) the skill locks while it runs
#   │         ├─ StateReference [ReferenceElement, 0..1] — the AID property
#   │         │    publishing the skill's state
#   │         └─ Implementation [SMC, 0..1] — FBType, TypeHash, InstancePath
#   │              of the IEC 61499 block that implements the skill
#   └─ Errors [SMC, 1] — always present, empty (not currently populated)

#################################################################
# ONTOLOGY METADATA
#################################################################

<https://w3id.org/2025/arso/modules/control-component>
  rdf:type owl:Ontology ;
  owl:imports <https://admin-shell.io/aas/3/1/> ;
  rdfs:comment """ARSO module: Control Component / Skills -- an ARSO-flattened adaptation of IDTA 02015-2-0 ControlComponentType (February 2025). See the design note above for how this diverges from the full standard. v0.5 adds optional reconfiguration elements per skill (Kind, Parameters, RealizesProperty, Contract, Uses, Execute/Stop, Occupies, StateReference, Implementation).

  Submodel semanticId: https://admin-shell.io/idta/ControlComponentType/1/0
  Cross-submodel: Skill InterfaceReference targets are validated in SPARQL SHACL (arso-rules.shacl.ttl).""" .


#################################################################
# SUBMODEL TYPE
#################################################################

arso:SkillsSubmodel rdf:type owl:Class ;
  rdfs:subClassOf aas:Submodel ;
  rdfs:label "Skills Submodel" ;
  arso:semanticId "https://admin-shell.io/idta/ControlComponentType/1/0" ,
                  "https://smartproductionlab.aau.dk/ARSO/Skills/1/0/Submodel" ;
  rdfs:comment "IDTA 02015 CCType — Control Component Type (Interfaces, Skills, Errors), ARSO-flattened; see design note above." .


#################################################################
# ELEMENT TYPES — Interfaces container (submodel level)
#################################################################

arso:CCInterfacesSMC rdf:type owl:Class ;
  rdfs:subClassOf aas:SubmodelElementCollection ;
  arso:parentClass arso:SkillsSubmodel ;
  arso:idShort "Interfaces" ;
  rdfs:comment "SMC Interfaces — mandatory top-level container, always present and always empty. ARSO handles interface binding per-skill via each SkillSMC's own InterfaceReference (see design note above), not via device-level entries here." .


#################################################################
# ELEMENT TYPES — Skills container (submodel level)
#################################################################

arso:CCSkillsSMC rdf:type owl:Class ;
  rdfs:subClassOf aas:SubmodelElementCollection ;
  arso:parentClass arso:SkillsSubmodel ;
  arso:idShort "Skills" ;
  rdfs:comment "SMC Skills — mandatory top-level container for all Skill entries. Always present, may be empty." .

arso:SkillSMC rdf:type owl:Class ;
  rdfs:subClassOf aas:SubmodelElementCollection ;
  arso:parentClass arso:CCSkillsSMC ;
  rdfs:comment "SMC {skill_name} — a named skill. Applied unconditionally to every direct child of Skills (no idShort — the skill name is user-defined). Contains SemanticId, an Operation, and an InterfaceReference (all mandatory), plus an optional StateMachine for asynchronous skills." .

arso:SkillSemanticIdProperty rdf:type owl:Class ;
  rdfs:subClassOf aas:Property ;
  arso:parentClass arso:SkillSMC ;
  arso:idShort "SemanticId" ;
  rdfs:comment "Property SemanticId (xs:string) — the skill's own semantic identifier URI (lab namespace convention, enforced via SHACL sh:pattern)." .

arso:SkillOperationElement rdf:type owl:Class ;
  rdfs:subClassOf aas:Operation ;
  arso:parentClass arso:SkillSMC ;
  rdfs:comment "Operation {skill_name} — the invocable Operation of a skill entry. Applied unconditionally to every direct child of a SkillSMC with AAS modelType Operation (no idShort — its idShort matches the skill name). Its semanticId must use the lab's URI namespace (enforced via SHACL sh:pattern)." .

arso:SkillInterfaceReferenceRef rdf:type owl:Class ;
  rdfs:subClassOf aas:ReferenceElement ;
  arso:parentClass arso:SkillSMC ;
  arso:idShort "InterfaceReference" ;
  rdfs:comment "ReferenceElement InterfaceReference — points directly at the specific AID action idShort (arso:InterfaceSMC/InteractionMetadata/actions/{action}) this skill invokes. Cross-submodel target validated via SPARQL SHACL, not OWL restriction (arso:SkillInterfaceRefActionShape / arso:SkillInterfaceRefTargetShape in arso-rules.shacl.ttl)." .

arso:SkillStateMachineProperty rdf:type owl:Class ;
  rdfs:subClassOf aas:Property ;
  arso:parentClass arso:SkillSMC ;
  arso:idShort "StateMachine" ;
  rdfs:comment "Property StateMachine (xs:string) — present only on asynchronous skills. Polled by clients for intermediate state (IDLE, RUNNING, SUCCESS, FAILURE) during execution." .


#################################################################
# ELEMENT TYPES — optional reconfiguration elements of a Skill (v0.5)
#
# ARSO's flattening dropped per-skill parameters and IDTA 02015's
# Uses. Reconfiguration needs them back: which capability property a
# parameter realizes, what a composite is made of, what it locks,
# and which runtime block implements it. All are optional, so skills
# generated for the MQTT stations stay valid.
#################################################################

arso:SkillKindProperty rdf:type owl:Class ;
  rdfs:subClassOf aas:Property ;
  arso:parentClass arso:SkillSMC ;
  arso:idShort "Kind" ;
  rdfs:comment "Property Kind (xs:string) — Primitive (one function of one equipment item, with a contract) or Composite (a sequence of other skills). Value enumeration enforced in SHACL." .

arso:SkillParametersSMC rdf:type owl:Class ;
  rdfs:subClassOf aas:SubmodelElementCollection ;
  arso:parentClass arso:SkillSMC ;
  arso:idShort "Parameters" ;
  rdfs:comment "SMC Parameters — the skill's parameters as Properties (css:SkillParameter); value is the current (deployed) value, qualifiers Unit, Minimum, Maximum and Default the declaration." .

arso:SkillParameterProperty rdf:type owl:Class ;
  rdfs:subClassOf aas:Property ;
  arso:parentClass arso:SkillParametersSMC ;
  rdfs:comment "Property {parameter} — one skill parameter (css:InputParameter). Applied to every Property directly in Parameters." .

arso:RealizesPropertyRel rdf:type owl:Class ;
  rdfs:subClassOf aas:RelationshipElement ;
  arso:parentClass arso:SkillSMC ;
  arso:idShort "RealizesProperty" ;
  rdfs:comment "RelationshipElement RealizesProperty — first: a parameter of this skill; second: a property (PropertyContainer) of a capability this skill realizes (CapabilityRealizedBy). The link the IDTA templates lack: it is where a product value reaches the controller (capability property -> skill parameter, css:isRealizedBySkillParameter)." .

arso:SkillContractSMC rdf:type owl:Class ;
  rdfs:subClassOf aas:SubmodelElementCollection ;
  arso:parentClass arso:SkillSMC ;
  arso:idShort "Contract" ;
  rdfs:comment "SMC Contract — for primitive skills: Requires (precondition), Ensures (postcondition) or After (open-loop duration), Invariant, Timeout. Conditions over the resource's state variables (css:Constraint). Composing skills relies on these contracts." .

arso:SkillUsesSML rdf:type owl:Class ;
  rdfs:subClassOf aas:SubmodelElementList ;
  arso:parentClass arso:SkillSMC ;
  arso:idShort "Uses" ;
  rdfs:comment "SML Uses — references to the skills a composite skill uses (IDTA 02015 Uses). Targets: skills of the same AAS or of an AAS that is a part of it in HierarchicalStructures (downward only; checked in SHACL, pprl:UsesDownwardShape)." .

arso:SkillSequenceSML rdf:type owl:Class ;
  rdfs:subClassOf aas:SubmodelElementList ;
  arso:parentClass arso:SkillSMC ;
  rdfs:comment "SML Execute or Stop — a composite's sequence of Steps (Execute: what Start runs; Stop: what Stop runs)." .

arso:SkillStepSMC rdf:type owl:Class ;
  rdfs:subClassOf aas:SubmodelElementCollection ;
  arso:parentClass arso:SkillSequenceSML ;
  rdfs:comment "SMC Step — one use of a skill in a sequence: Skill [ReferenceElement, 1] to a skill listed in Uses, and Bindings [SMC of Property, 0..1] with the constants bound to its parameters (current values)." .

arso:SkillOccupiesSML rdf:type owl:Class ;
  rdfs:subClassOf aas:SubmodelElementList ;
  arso:parentClass arso:SkillSMC ;
  arso:idShort "Occupies" ;
  rdfs:comment "SML Occupies — references to HierarchicalStructures nodes (equipment) the skill locks while it runs; two skills occupying one node never run at once." .

arso:SkillStateReferenceRef rdf:type owl:Class ;
  rdfs:subClassOf aas:ReferenceElement ;
  arso:parentClass arso:SkillSMC ;
  arso:idShort "StateReference" ;
  rdfs:comment "ReferenceElement StateReference — the AID property that publishes this skill's state (the synchronous alternative to StateMachine)." .

arso:SkillImplementationSMC rdf:type owl:Class ;
  rdfs:subClassOf aas:SubmodelElementCollection ;
  arso:parentClass arso:SkillSMC ;
  arso:idShort "Implementation" ;
  rdfs:comment "SMC Implementation — the runtime block implementing the skill: FBType (qualified IEC 61499 type), TypeHash (as the runtime reports it) and InstancePath (dotted instance name). Lets a reader check that the described skill is the deployed one." .


#################################################################
# ELEMENT TYPES — Errors (submodel level)
#################################################################

arso:CCErrorsSMC rdf:type owl:Class ;
  rdfs:subClassOf aas:SubmodelElementCollection ;
  arso:parentClass arso:SkillsSubmodel ;
  arso:idShort "Errors" ;
  rdfs:comment "SMC Errors — mandatory top-level container for global CC error entries. Always present, may be empty; not currently populated by the generation pipeline." .

arso:ErrorSMC rdf:type owl:Class ;
  rdfs:subClassOf aas:SubmodelElementCollection ;
  arso:parentClass arso:CCErrorsSMC ;
  rdfs:comment "SMC {error_name} — a named error entry, if populated." .

arso:ErrorCodeProperty rdf:type owl:Class ;
  rdfs:subClassOf aas:Property ;
  arso:parentClass arso:ErrorSMC ;
  arso:idShort "ErrorCode" ;
  rdfs:comment "Property ErrorCode (xs:integer) — numeric error code identifying this error." .


#################################################################
# CONTAINMENT CONSTRAINTS
#################################################################

# SkillsSubmodel must contain exactly one Interfaces, Skills, and Errors container
arso:SkillsSubmodel rdfs:subClassOf [
  rdf:type owl:Restriction ;
  owl:onProperty <https://admin-shell.io/aas/3/1/Submodel/submodelElements> ;
  owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
  owl:onClass arso:CCInterfacesSMC ] .

arso:SkillsSubmodel rdfs:subClassOf [
  rdf:type owl:Restriction ;
  owl:onProperty <https://admin-shell.io/aas/3/1/Submodel/submodelElements> ;
  owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
  owl:onClass arso:CCSkillsSMC ] .

arso:SkillsSubmodel rdfs:subClassOf [
  rdf:type owl:Restriction ;
  owl:onProperty <https://admin-shell.io/aas/3/1/Submodel/submodelElements> ;
  owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
  owl:onClass arso:CCErrorsSMC ] .

# Each Skill must contain SemanticId, an Operation, and an InterfaceReference (all mandatory)
arso:SkillSMC rdfs:subClassOf [
  rdf:type owl:Restriction ;
  owl:onProperty <https://admin-shell.io/aas/3/1/SubmodelElementCollection/value> ;
  owl:someValuesFrom arso:SkillSemanticIdProperty ] .

arso:SkillSMC rdfs:subClassOf [
  rdf:type owl:Restriction ;
  owl:onProperty <https://admin-shell.io/aas/3/1/SubmodelElementCollection/value> ;
  owl:someValuesFrom arso:SkillOperationElement ] .

arso:SkillSMC rdfs:subClassOf [
  rdf:type owl:Restriction ;
  owl:onProperty <https://admin-shell.io/aas/3/1/SubmodelElementCollection/value> ;
  owl:someValuesFrom arso:SkillInterfaceReferenceRef ] .

# Skill.StateMachine: at most one (present only for asynchronous skills)
arso:SkillSMC rdfs:subClassOf [
  rdf:type owl:Restriction ;
  owl:onProperty <https://admin-shell.io/aas/3/1/SubmodelElementCollection/value> ;
  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
  owl:onClass arso:SkillStateMachineProperty ] .

# Optional reconfiguration elements: at most one each (v0.5)
arso:SkillSMC rdfs:subClassOf
  [ rdf:type owl:Restriction ; owl:onProperty <https://admin-shell.io/aas/3/1/SubmodelElementCollection/value> ;
    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; owl:onClass arso:SkillKindProperty ],
  [ rdf:type owl:Restriction ; owl:onProperty <https://admin-shell.io/aas/3/1/SubmodelElementCollection/value> ;
    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; owl:onClass arso:SkillParametersSMC ],
  [ rdf:type owl:Restriction ; owl:onProperty <https://admin-shell.io/aas/3/1/SubmodelElementCollection/value> ;
    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; owl:onClass arso:SkillContractSMC ],
  [ rdf:type owl:Restriction ; owl:onProperty <https://admin-shell.io/aas/3/1/SubmodelElementCollection/value> ;
    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; owl:onClass arso:SkillUsesSML ],
  [ rdf:type owl:Restriction ; owl:onProperty <https://admin-shell.io/aas/3/1/SubmodelElementCollection/value> ;
    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; owl:onClass arso:SkillOccupiesSML ],
  [ rdf:type owl:Restriction ; owl:onProperty <https://admin-shell.io/aas/3/1/SubmodelElementCollection/value> ;
    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; owl:onClass arso:SkillStateReferenceRef ],
  [ rdf:type owl:Restriction ; owl:onProperty <https://admin-shell.io/aas/3/1/SubmodelElementCollection/value> ;
    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; owl:onClass arso:SkillImplementationSMC ] .

# A Step names exactly one skill
arso:SkillStepSMC rdfs:subClassOf [
  rdf:type owl:Restriction ;
  owl:onProperty <https://admin-shell.io/aas/3/1/SubmodelElementCollection/value> ;
  owl:someValuesFrom aas:ReferenceElement ] .

# Each Error entry must contain ErrorCode (mandatory)
arso:ErrorSMC rdfs:subClassOf [
  rdf:type owl:Restriction ;
  owl:onProperty <https://admin-shell.io/aas/3/1/SubmodelElementCollection/value> ;
  owl:someValuesFrom arso:ErrorCodeProperty ] .
